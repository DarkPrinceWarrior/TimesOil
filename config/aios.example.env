# --- LLM route A: Tatneft (fallback) --------------------------------------
LLM_BASE_URL=https://litellm.tatneft.guru/v1
LLM_MODEL=qwen3.8-27b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
# Optional explicit CONNECT proxy; A100 nci-egress-proxy: http://127.0.0.1:10809
LLM_PROXY_URL=

# --- LLM route B: Cerebras Developer tier (main route, design 4.4) ---------
# Uncomment the block below instead of route A. The key is read from a runtime
# file on A100 and never stored here:
#   test -s /dev/shm/timesoil-cerebras-key && export LLM_API_KEY="$(</dev/shm/timesoil-cerebras-key)"
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_MODEL=qwen-3.8-27b
# LLM_TIMEOUT_SECONDS=600
# LLM_MAX_OUTPUT_TOKENS=8192
# reasoning_effort: none|low|medium|high (high = Qwen xhigh); Cerebras only.
# LLM_REASONING_EFFORT=high
# Best-effort determinism ("Determinism is not guaranteed"); Cerebras only.
# LLM_SEED=20260909
# presence_penalty in [-2, 2]; Cerebras only.
# LLM_PRESENCE_PENALTY=0.0

# --- LLM auditability (both routes) ---------------------------------------
# One JSON line per HTTP attempt: request/messages/response/content/reasoning/
# tool_calls hashes, system_fingerprint, finish_reason, usage, time_info,
# http_status, attempt, latency. Never contains the API key.
# LLM_CALL_LOG=/app/runs/llm_calls.jsonl
# Offline replay of a recorded run (no network calls). Build the directory with
# timesoil.aios.llm.export_replay_dir(call_log, replay_dir).
# LLM_REPLAY_DIR=

AIOS_RUNS_DIR=/app/runs
CHDD_PYTHON_DIR=/app/docs/hackathon/chdd/CHDD_PYTHON
CHDD_TIMEOUT_SECONDS=300
