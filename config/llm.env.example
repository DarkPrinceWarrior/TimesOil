# LLM route for the AIOS agents (OpenAI-compatible endpoint). Copy to config/llm.env,
# fill in the key, then before scripts/run_case_z.sh:   set -a; . config/llm.env; set +a
LLM_BASE_URL=https://litellm.tatneft.guru/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=<key>
LLM_TIMEOUT_SECONDS=600
LLM_MAX_OUTPUT_TOKENS=8192
# Alternative route (Cerebras): LLM_BASE_URL=https://api.cerebras.ai/v1 LLM_MODEL=qwen-3.8-27b
# LLM_REASONING_EFFORT=high LLM_SEED=20260909; add LLM_PROXY_URL=http://host:port if the API is geo-blocked.
