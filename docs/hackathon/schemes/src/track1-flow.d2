vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 28
  }
}

direction: down

classes: {
  step: {
    style: {
      fill: "#1a1c19"
      stroke: "#c4a35a"
      font-color: "#e8e0d0"
      border-radius: 6
    }
  }
  gold: {
    style: {
      fill: "#c4a35a"
      stroke: "#141612"
      font-color: "#141612"
      border-radius: 6
    }
  }
  lane: {
    style: {
      fill: "#141612"
      stroke: "#c4a35a"
      font-color: "#e8e0d0"
    }
  }
}

title: |md
  # Трек 1 · месячный цикл полной ГДМ
| {near: top-center}

board: {
  grid-rows: 5
  grid-gap: 28
  width: 2200
  style.fill: "#0f100e"
  style.stroke: "#c4a35a"

  state: {
    label: "1. Состояние"
    class: lane
    grid-columns: 2
    restart: restart_t {class: gold}
    diag: диагностика {class: step}
  }

  agents: {
    label: "2. Агенты"
    class: lane
    grid-columns: 3
    intents: намерения {class: step}
    actions: "допустимые действия" {class: step}
    ban: "LLM не считает дебиты" {class: step}
  }

  screen: {
    label: "3. Отсев"
    class: lane
    grid-columns: 2
    crm: "CRM / CRMP / Джентил" {class: step}
    keep: "TimesOil только отсев" {class: step}
  }

  world: {
    label: "4. Мир · полная ГДМ"
    class: lane
    grid-columns: 2
    gdm: "полная ГДМ финалистов" {class: gold}
    engine: "tNavigator или OPM Flow" {class: step}
  }

  money: {
    label: "5. Деньги и шлюз"
    class: lane
    grid-columns: 5
    chdd: CHDD_PYTHON {class: gold}
    gate: "защитный контур" {class: step}
    lock: "зафиксировать месяц t" {class: step}
    sched: "wells_schedule += месяц" {class: gold}
    nxt: "restart t+1" {class: gold}
  }
}

board.state.restart -> board.state.diag
board.state.diag -> board.agents.intents
board.agents.intents -> board.agents.actions
board.agents.ban -> board.agents.intents: {style.stroke-dash: 3}
board.agents.actions -> board.screen.crm
board.screen.crm -> board.world.gdm
board.world.gdm -> board.money.chdd
board.money.chdd -> board.money.gate
board.money.gate -> board.money.lock: принять
board.money.lock -> board.money.sched
board.money.sched -> board.money.nxt
board.money.nxt -> board.state.restart: ещё месяц {style.stroke: "#9a3b2f"}
