%% Трек 2 · Model Z: от Model_Z_final_OPM до сдачи
flowchart TB
    classDef charcoal fill:#1a1c19,stroke:#c4a35a,stroke-width:1.5px,color:#e8e0d0
    classDef amber fill:#c4a35a,stroke:#141612,stroke-width:1.5px,color:#141612

    subgraph inBox["1. Вход"]
        zDeck["архив Model_Z_final_OPM"]:::amber
        ovl["overlay SUMMARY<br/>оригинал не менять"]:::charcoal
        zDeck --> ovl
    end

    subgraph doeBox["2. Свои прогоны"]
        own["свои прогоны OPM Flow<br/>дампов организаторов нет"]:::charcoal
    end

    subgraph surBox["3. Суррогат"]
        phys["CRM / матбаланс"]:::charcoal
        tab["табличный / граф<br/>GNN опционален"]:::charcoal
        uq["шлюз UQ / OOD"]:::charcoal
        phys --> tab --> uq
    end

    subgraph agBox["4. Агенты"]
        cyc["тот же цикл, что в треке 1"]:::charcoal
        world["мир = суррогат"]:::amber
        cyc --> world
    end

    subgraph searchBox["5. Поиск полных графиков"]
        many["много полных графиков<br/>на суррогате"]:::charcoal
        cheap["CHDD_PYTHON дешёвый"]:::charcoal
        many --> cheap
    end

    subgraph replayBox["6. Один полный replay"]
        best["лучший кандидат"]:::charcoal
        opm["один полный прогон OPM Flow<br/>Model_Z_final_OPM на весь горизонт"]:::amber
        fields["таблица 14 полей"]:::charcoal
        best --> opm --> fields
    end

    subgraph ecoBox["7. Официальный ЧДД"]
        chdd["CHDD_PYTHON --start-year 2007"]:::amber
        forbid["не 1991, не 4418"]:::charcoal
        chdd --- forbid
    end

    subgraph cmpBox["8. Компилятор"]
        inc["wells_schedule.inc"]:::amber
    end

    subgraph packBox["9. Сдача"]
        pack["график + ЧДД + суррогат / метрики"]:::amber
        org["организаторы: один ГДМ"]:::charcoal
        pack --> org
    end

    ovl --> own
    own --> phys
    uq --> cyc
    world --> many
    world -.-> uq
    cheap --> best
    fields --> chdd
    chdd --> inc
    inc --> pack
