%% Трек 1 · Model Y: от входящих данных до сдачи организаторам
flowchart TB

classDef charcoal fill:#1a1c19,stroke:#c4a35a,stroke-width:1.5px,color:#e8e0d0
classDef amber fill:#c4a35a,stroke:#141612,stroke-width:1.5px,color:#141612

subgraph sg_vhod ["1. Вход"]
    vhod_zip[("архив Model Y")]:::amber
    vhod_hist["история до 2014-01"]:::charcoal
    vhod_case["тестовый кейс: лимиты позже"]:::charcoal
    vhod_zip --> vhod_hist --> vhod_case
end

subgraph sg_sost ["2. Состояние"]
    sost_load["загрузчик кейса"]:::charcoal
    sost_fields["14 полей: DATA, well, WLPT, WLPR, WOMT, WOMR, WWIR, WWIT, THP, BHP, WEFF, WLPT_Diff, WOMT_Diff, WWIT_Diff"]:::charcoal
    sost_bloki["фонд 49 скважин, блоки A, B, B2, C, D, E"]:::charcoal
    sost_diag["диагностика состояния"]:::charcoal
    sost_load --> sost_fields --> sost_bloki --> sost_diag
end

subgraph sg_agen ["3. Агенты"]
    agen_coord["координатор поля"]:::charcoal
    agen_blk["агенты блоков A, B, B2, C, D, E"]:::charcoal
    agen_inj["агент закачки"]:::charcoal
    agen_prd["агент добычи"]:::charcoal
    agen_ban["языковая модель не пишет числа"]:::charcoal
    agen_intent["типизированные намерения"]:::charcoal
    agen_coord --> agen_blk
    agen_coord --> agen_inj
    agen_coord --> agen_prd
    agen_blk --> agen_intent
    agen_inj --> agen_intent
    agen_prd --> agen_intent
    agen_ban -.-> agen_intent
end

subgraph sg_kand ["4. Кандидаты"]
    kand_proj["проекция жёстких ограничений"]:::charcoal
    kand_set["допустимые кандидаты"]:::charcoal
    kand_crm["отсев CRM / CRMP / Джентил"]:::charcoal
    kand_proj --> kand_set --> kand_crm
end

subgraph sg_mir ["5. Мир"]
    mir_sim{"паритет OPM Flow?"}:::charcoal
    mir_tnav["полная ГДМ: tNavigator"]:::amber
    mir_flow["полная ГДМ: OPM Flow"]:::amber
    mir_run["полная ГДМ на принятый месяц"]:::charcoal
    mir_gate{"защитный контур"}:::charcoal
    mir_noop["оставить без действия"]:::charcoal
    mir_acc["зафиксировать месяц t"]:::charcoal
    mir_rst["снимок t к снимку t+1"]:::charcoal
    mir_loop{"цикл ~23 мес с 2014?"}:::charcoal
    mir_sim -->|нет| mir_tnav
    mir_sim -->|да| mir_flow
    mir_tnav --> mir_run
    mir_flow --> mir_run
    mir_run --> mir_gate
    mir_gate -->|принять| mir_acc
    mir_gate -->|все красные| mir_noop
    mir_noop --> mir_acc
    mir_acc --> mir_rst --> mir_loop
end

subgraph sg_deng ["6. Деньги"]
    deng_tab["таблица 14 полей"]:::charcoal
    deng_chdd["CHDD_PYTHON --start-year 2014"]:::amber
    deng_npv["заявленный ЧДД"]:::amber
    deng_tab --> deng_chdd --> deng_npv
end

subgraph sg_graf ["7. График"]
    graf_comp["компилятор расписания"]:::charcoal
    graf_inc["wells_schedule.inc"]:::amber
    graf_rt{"повторный разбор совпал?"}:::charcoal
    graf_comp --> graf_inc --> graf_rt
end

subgraph sg_sdach ["8. Сдача"]
    sdach_pack["пакет: код, интерфейс, график, заявленный ЧДД"]:::amber
    sdach_jury["организаторы: один прогон ГДМ + тот же CHDD_PYTHON"]:::amber
    sdach_pack --> sdach_jury
end

vhod_case --> sost_load
sost_diag --> agen_coord
agen_intent --> kand_proj
kand_crm --> mir_sim
mir_loop -->|ещё месяц| sost_diag
mir_loop -->|горизонт закрыт| deng_tab
deng_npv --> graf_comp
graf_rt -->|расхождение| graf_comp
graf_rt -->|совпало| sdach_pack

