vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 28
  }
}

direction: down

classes: {
  step: {
    style: {
      fill: "#1a1c19"
      stroke: "#c4a35a"
      font-color: "#e8e0d0"
      border-radius: 6
    }
  }
  gold: {
    style: {
      fill: "#c4a35a"
      stroke: "#141612"
      font-color: "#141612"
      border-radius: 6
    }
  }
  lane: {
    style: {
      fill: "#141612"
      stroke: "#c4a35a"
      font-color: "#e8e0d0"
    }
  }
}

title: |md
  # Трек 2 · суррогат, затем один replay
| {near: top-center}

board: {
  grid-rows: 3
  grid-gap: 28
  width: 2200
  style.fill: "#0f100e"
  style.stroke: "#c4a35a"

  fast: {
    label: "1. Суррогат · много полных графиков"
    class: lane
    grid-columns: 5
    agents: агенты {class: step}
    phys: "CRM / матбаланс" {class: step}
    tab: "табличный / граф" {class: step}
    uq: "шлюз UQ / OOD" {class: step}
    cand: "новый кандидат" {class: gold}
  }

  econ: {
    label: "2. Дешёвый ЧДД на суррогате"
    class: lane
    grid-columns: 3
    cheap: "CHDD_PYTHON черновик" {class: step}
    loop: "цикл поиска" {class: step}
    pick: "топ кандидат" {class: gold}
  }

  replay: {
    label: "3. Один полный replay"
    class: lane
    grid-columns: 5
    best: "лучший график" {class: gold}
    opm: "один прогон OPM Flow · Model_Z_final_OPM" {class: gold}
    fields: "таблица 14 полей" {class: step}
    chdd: "CHDD_PYTHON --start-year 2007" {class: gold}
    pack: "сдача: график + ЧДД + суррогат" {class: gold}
  }
}

board.fast.agents -> board.fast.phys
board.fast.phys -> board.fast.tab
board.fast.tab -> board.fast.uq
board.fast.uq -> board.fast.cand
board.fast.cand -> board.econ.cheap
board.econ.cheap -> board.econ.loop
board.econ.loop -> board.fast.agents: ещё кандидат
board.econ.loop -> board.econ.pick
board.econ.pick -> board.replay.best
board.replay.best -> board.replay.opm
board.replay.opm -> board.replay.fields
board.replay.fields -> board.replay.chdd
board.replay.chdd -> board.replay.pack
