#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Состояние и действия" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Начальная проверка" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Исходная физическая модель&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Model_Y (3).zip&lt;br&gt;MODEL_Y/MODEL_Y.DATA&lt;br&gt;INCLUDE/DemoSpe_002_2_sch.inc&lt;br&gt;Геометрия и комплектации сохраняются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;build_backend&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::build_backend" source="scripts/run_track1_mpc.py::build_backend"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Входной JSON v1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;schema: track1-mpc-input/v1&lt;br&gt;case + initial_state + candidates + opm&lt;br&gt;Размер ≤16 MiB; конечные числа&lt;br&gt;Повторные JSON-ключи запрещены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;load_config&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::load_config" source="scripts/run_track1_mpc.py::load_config"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Case&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;case_id; start; end; economics_start&lt;br&gt;producers[]; injectors[]&lt;br&gt;max_liquid_rate=500 м³/сут&lt;br&gt;allow_conversion_to_injection=false&lt;br&gt;operating_constraints[]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;Case&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::Case" source="src/timesoil/aios/contracts.py::Case"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Сетка управления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Даты: первые числа месяцев&lt;br&gt;start … end включительно&lt;br&gt;Для каждого месяца — весь фонд&lt;br&gt;В full-field: одна базовая опция&lt;br&gt;Нет дубликатов well × month&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;load_config&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::load_config" source="scripts/run_track1_mpc.py::load_config"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Официальная экономика&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нормативы_ЧДД.xlsx&lt;br&gt;Листы Нормативы и ЭЦН&lt;br&gt;РАСЧЕТ_ЧДД.py + chdd_model.py&lt;br&gt;excel_io.py; фиксируются SHA-256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CHDDEconomicsAdapter&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDDEconomicsAdapter" source="src/timesoil/aios/economics.py::CHDDEconomicsAdapter"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;OPM-настройки&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;source; deck; schedule_include&lt;br&gt;runs_dir; normalize_model_y&lt;br&gt;parsing_strictness=low в этом кейсе&lt;br&gt;density_map при необходимости&lt;br&gt;timeout_seconds=3600 в запуске&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;RunConfig&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::RunConfig" source="scripts/run_track1_mpc.py::RunConfig"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;State&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;case_id + month + restart_ref&lt;br&gt;wells: tuple[WellState]&lt;br&gt;Имена уникальны, фонд полный&lt;br&gt;В начальном состоянии month=start&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;State&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::State" source="src/timesoil/aios/contracts.py::State"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;WellState&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;well; role; active&lt;br&gt;oil_rate / liquid_rate / injection_rate&lt;br&gt;Поверхностные м³/сут; bhp в бар&lt;br&gt;0 ≤ нефть ≤ жидкость&lt;br&gt;Ни NaN, ни отрицательных дебитов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;WellState&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::WellState" source="src/timesoil/aios/contracts.py::WellState"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Первое состояние из OPM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Ссылка на базовый manifest.json&lt;br&gt;Проверка pinned-образа и исходника&lt;br&gt;Повторяемое извлечение SUMMARY&lt;br&gt;Сверка всех скважин на дату start&lt;br&gt;Начальная принятая история пуста&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_authenticated_history&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history" source="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Хэши конфигурации&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;config_sha256 — входная конфигурация&lt;br&gt;source_sha256 — исходная модель&lt;br&gt;input_sha256 связывает входы&lt;br&gt;run_id = track1-&amp;lt;24 символа хэша&amp;gt;&lt;br&gt;Пути и секреты не смешиваются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_id&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::RunConfig/run_id" source="scripts/run_track1_mpc.py::RunConfig/run_id"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;ControlAction&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;month; well; role; status&lt;br&gt;target: ORAT / LRAT / WRAT&lt;br&gt;value: конечное число ≥0&lt;br&gt;bhp_limit?: положительный бар&lt;br&gt;None не добавляется в старый JSON&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;ControlAction&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::ControlAction" source="src/timesoil/aios/contracts.py::ControlAction"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Смысл команды&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PROD → ORAT или LRAT&lt;br&gt;INJ → WRAT → OPM WATER/RATE&lt;br&gt;SHUT требует value=0&lt;br&gt;BHP здесь — граница при rate-control&lt;br&gt;Прямого BHP/THP-режима нет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;__post_init__&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::ControlAction/__post_init__" source="src/timesoil/aios/contracts.py::ControlAction/__post_init__"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Календарь и информация&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Исходный будущий график дан в кейсе&lt;br&gt;При планировании считается известным&lt;br&gt;Будущие измеренные состояния скрыты&lt;br&gt;Номер отсутствующей скважины&lt;br&gt;не даёт права её придумать&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Операционные ограничения&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Период start/end и явная wells[]&lt;br&gt;unavailable или limits{}&lt;br&gt;Неизвестные ключи → ошибка&lt;br&gt;Все численные пределы — данные кейса&lt;br&gt;Отсутствующая квота не выдумывается&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;parse_constraints&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py::parse_constraints" source="src/timesoil/aios/operating_constraints.py::parse_constraints"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Результат кандидата&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;GdmResult: Trajectory + Economics&lt;br&gt;planning_economics? + planning_end?&lt;br&gt;run_id, actions, next_state&lt;br&gt;certified + chdd_complete&lt;br&gt;invariant_violations должны быть пусты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;GdmResult&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::GdmResult" source="src/timesoil/aios/track1.py::GdmResult"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Результат всего периода&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Track1Result: ScheduleArtifact&lt;br&gt;Evidence: все месячные Trajectory&lt;br&gt;Все step_economics + backend_provenance&lt;br&gt;Скомпилированные выбранные действия&lt;br&gt;Последний ЧДД — накопленный итог&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;Evidence&lt;/span&gt;" tooltip="src/timesoil/aios/contracts.py::Evidence" source="src/timesoil/aios/contracts.py::Evidence"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="пути" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="типизация" edge="1" parent="1" source="b" target="c" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" flow="границы" edge="1" parent="1" source="c" target="d" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" flow="настройка адаптера" edge="1" parent="1" source="e" target="f" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge4" value="" flow="каждая скважина" edge="1" parent="1" source="g" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="" flow="S₀" edge="1" parent="1" source="i" target="g" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="245" y="635" /><mxPoint x="1145" y="635" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="" flow="привязка" edge="1" parent="1" source="j" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="916" y="750" /><mxPoint x="916" y="288" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="" flow="валидация" edge="1" parent="1" source="k" target="l" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge8" value="" flow="допустимость" edge="1" parent="1" source="n" target="k" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="695" y="866" /><mxPoint x="1145" y="866" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="" flow="накопление принятого" edge="1" parent="1" source="o" target="p" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><object id="foot" label="Трек 1 · 02/12 · Источники: audit-track1-20260909@c088d2d · 09.09.2026 · Полные ссылки в свойствах блока" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=12;fontColor=#52645F;align=left;"><mxGeometry as="geometry" x="40" y="1139" width="1760" height="35" /></mxCell></object></root></mxGraphModel></diagram><diagram id="pg03" name="03 · Qwen и инструменты"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="03 · Qwen и инструменты" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Один внешний Qwen исполняет четыре роли последовательно. Это роли протокола, а не четыре отдельные модели." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Контекст и API" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Роли до симуляции" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Планировщик и инструмент" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Критик после симуляции" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Внешний клиент&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;ExternalQwenClient&lt;br&gt;TatneftLLMClient — совместимый alias&lt;br&gt;HTTPS api.cerebras.ai/v1&lt;br&gt;model=qwen-3.8-27b&lt;br&gt;Локальный GPU для LLM не нужен&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;ExternalQwenClient&lt;/span&gt;" tooltip="src/timesoil/aios/llm.py::ExternalQwenClient" source="src/timesoil/aios/llm.py::ExternalQwenClient"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Координатор&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Читает проверенный Sₜ и цель&lt;br&gt;Определяет следующий проверяемый шаг&lt;br&gt;Не придумывает численные результаты&lt;br&gt;approved до OPM разрешает расчёт&lt;br&gt;Это ещё не подтверждение результата&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_plan&lt;/span&gt;" tooltip="src/timesoil/aios/agents.py::AgentWorkflow/run_plan" source="src/timesoil/aios/agents.py::AgentWorkflow/run_plan"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Аналитик пласта&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Получает тот же контекст&lt;br&gt;И решение предыдущей роли&lt;br&gt;Обсуждает добычу, воду, давление&lt;br&gt;Гипотезы отделены от численных фактов&lt;br&gt;Будущих результатов OPM ещё нет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_ROLE_PROMPTS&lt;/span&gt;" tooltip="src/timesoil/aios/agents.py::_ROLE_PROMPTS" source="src/timesoil/aios/agents.py::_ROLE_PROMPTS"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Планировщик&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Выбирает изменения любых скважин&lt;br&gt;Цель: полный официальный ЧДД&lt;br&gt;Не пишет текст SCHEDULE вручную&lt;br&gt;Обязан вызвать propose_controls&lt;br&gt;Ровно одна полная заявка на шаг&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Переданный контекст&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Sₜ, полный фонд, текущий вариант&lt;br&gt;Последние 3 принятых месячных отчёта&lt;br&gt;Нормативы + ЭЦН + ограничения&lt;br&gt;Даты наблюдений/цели/принятия&lt;br&gt;Без будущих наблюдённых состояний&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;RoleDecision&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;role; approved; summary&lt;br&gt;recommendation; evidence&lt;br&gt;tool_evidence добавляется кодом&lt;br&gt;JSON проверяется локальным парсером&lt;br&gt;Утверждение модели не равно квитанции&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_parse_decision&lt;/span&gt;" tooltip="src/timesoil/aios/agents.py::_parse_decision" source="src/timesoil/aios/agents.py::_parse_decision"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;propose_controls({updates})&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;well, status, target, value обязательны&lt;br&gt;role и bhp_limit необязательны&lt;br&gt;Неуказанные скважины сохраняются&lt;br&gt;Пустой updates сохраняет текущий план&lt;br&gt;Дубликаты/чужие well → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_propose_controls&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_propose_controls" source="scripts/run_track1_mpc.py::_propose_controls"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Ответ инструмента&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;49 полных ControlAction&lt;br&gt;well_count; inventory_matches_case&lt;br&gt;controls_validated; missing/extra=[]&lt;br&gt;SHA-256 канонического графика&lt;br&gt;Ещё нет обещания роста ЧДД&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;ToolRegistry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Разрешённые инструменты по роли&lt;br&gt;JSON Schema: additionalProperties=false&lt;br&gt;Имена и аргументы валидируются&lt;br&gt;Неизвестный tool → отказ&lt;br&gt;Обязательный вызов нельзя пропустить&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;ToolRegistry&lt;/span&gt;" tooltip="src/timesoil/aios/agents.py::ToolRegistry" source="src/timesoil/aios/agents.py::ToolRegistry"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Исправление плана&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;До 2 попыток планирования&lt;br&gt;Ошибка ввода → invalid_proposal&lt;br&gt;Отказ → rejected_planning&lt;br&gt;Передаётся конкретная ошибка&lt;br&gt;Невалидный график не запускается&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Данные после полного OPM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Выбранная Trajectory и Sₜ₊₁&lt;br&gt;Накопленный и полный плановый ЧДД&lt;br&gt;Хэши графика, исходника, lineage&lt;br&gt;Фактический максимум жидкости&lt;br&gt;Результаты детерминированных проверок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;review&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/review" source="scripts/run_track1_mpc.py::execute/review"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;verify_month_evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Обязательный инструмент критика&lt;br&gt;Возвращает квитанции текущего месяца&lt;br&gt;Критик сопоставляет факты и выводы&lt;br&gt;Без суррогата UQ/OOD неприменимы&lt;br&gt;Рост ЧДД требует парной базы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;review&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/review" source="scripts/run_track1_mpc.py::execute/review"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Транспортные отказы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;До 3 запросов в пределах timeout&lt;br&gt;Повтор: transport / 408 / 429 / 5xx&lt;br&gt;Retry-After учитывается&lt;br&gt;HTTP 400 автоматически не повторяется&lt;br&gt;Секрет API не записывается в схему&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_post&lt;/span&gt;" tooltip="src/timesoil/aios/llm.py::ExternalQwenClient/_post" source="src/timesoil/aios/llm.py::ExternalQwenClient/_post"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Журнал на каждом этапе&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;planning / invalid_proposal&lt;br&gt;rejected_planning&lt;br&gt;terminal_month_review&lt;br&gt;rejected_month_review&lt;br&gt;JSONL: flush + fsync&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;record&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/record" source="scripts/run_track1_mpc.py::execute/record"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Отказ критика&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Одна повторная проверка доказательств&lt;br&gt;Исходный отказ сохраняется&lt;br&gt;Повторный отказ → RuntimeError&lt;br&gt;Месяц не переносится в S следующего шага&lt;br&gt;Физические артефакты сохраняются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;review&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/review" source="scripts/run_track1_mpc.py::execute/review"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Одобрение критика&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;previous_controls обновляется&lt;br&gt;feedback получает месяц и Sₜ₊₁&lt;br&gt;on_step завершается успешно&lt;br&gt;MonthlyMPC переносит состояние&lt;br&gt;Далее снова контекст для Qwen&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/run" source="src/timesoil/aios/track1.py::MonthlyMPC/run"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="API" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="решение" edge="1" parent="1" source="b" target="c" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" flow="анализ" edge="1" parent="1" source="c" target="d" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" flow="факты" edge="1" parent="1" source="e" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;str