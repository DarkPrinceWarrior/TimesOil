ex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Расширенные механизмы" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Открытые условия" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Что считать завершением" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Полный период пройден&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;2014-01-01 … 2015-12-01 exclusive&lt;br&gt;23 управляемых месяца&lt;br&gt;49 скважин; 1 127 команд&lt;br&gt;23 одобренных месячных review&lt;br&gt;364 lineage-артефакта проверено&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;lifecycle-audit.json&lt;/span&gt;" tooltip="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json" source="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экономический результат Y&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Baseline: 1 030,883174 млн руб.&lt;br&gt;Candidate: 1 030,883174 млн руб.&lt;br&gt;ΔЧДД =0; прирост =0%&lt;br&gt;Парная история совпадает&lt;br&gt;Цель улучшения ≥5% не достигнута&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;lifecycle-audit.json&lt;/span&gt;" tooltip="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json" source="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Как завершён цикл&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Продолжение после отказа на 12 месяцах&lt;br&gt;Ещё продолжение после HTTP 400 на 20&lt;br&gt;Префиксы проверены по физическим данным&lt;br&gt;Старые логи сохранены&lt;br&gt;Безотказная автономность не доказана&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;result.json&lt;/span&gt;" tooltip="deliverables/track1_model_y/full_horizon_20260909/result.json" source="deliverables/track1_model_y/full_horizon_20260909/result.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Новые функции отдельно&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;BHP-границы и PROD→INJ&lt;br&gt;Операционные лимиты и простой&lt;br&gt;Полный нормативный профиль&lt;br&gt;Реальные OPM-проверки по 2 месяца&lt;br&gt;Это не ретроактивное изменение 23 шагов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;control_coverage_20260909&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909" source="deliverables/control_coverage_20260909"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверка перевода&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Скв. 1 → INJ, WRAT=80, BHP≤280&lt;br&gt;Факт: 75,337502 / 67,789597 м³/сут&lt;br&gt;BHP=280 в обоих месяцах&lt;br&gt;Перевод: один раз 5 млн&lt;br&gt;Без лишнего события stop/start&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;conversion-bhp-verification.json&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909/conversion-bhp-verification.json" source="deliverables/control_coverage_20260909/conversion-bhp-verification.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверка совмещённых лимитов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Скв. 14 SHUT с нулевыми потоками&lt;br&gt;Скв. 1: min10/max80, BHP≤280&lt;br&gt;Скв. 12: LRAT≤100, BHP≥70&lt;br&gt;Обводнённость проверяется по факту&lt;br&gt;Нарушения и неизвестные ключи отклонены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;operating-constraints-verification.json&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909/operating-constraints-verification.json" source="deliverables/control_coverage_20260909/operating-constraints-verification.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Нормативы проверены&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Все 19 строк, 25 effective параметров&lt;br&gt;7 locks и 12 ЭЦН&lt;br&gt;Ненулевой имущественный налог проверен&lt;br&gt;Амортизация также проверена&lt;br&gt;Неизвестный тариф ремонта отклонён&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;official-normative-profile.json&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909/official-normative-profile.json" source="deliverables/control_coverage_20260909/official-normative-profile.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Предел полного запуска&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Первые 20 месяцев: прежний контроллер&lt;br&gt;Последние 3: полный профиль для Qwen&lt;br&gt;Переводы в полном кейсе отключены&lt;br&gt;Расходы всё время считал официальный код&lt;br&gt;Не весь расширенный набор применён 23 раза&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;THP и штуцеры&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нет VFPPROD / VFPINJ в архивах&lt;br&gt;Не задана модель подъёма/штуцера&lt;br&gt;BHP-граница не заменяет эти данные&lt;br&gt;THPRES относится к областям пласта&lt;br&gt;Нельзя объявлять поддержку проверенной&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;organizer-archive-inventory.json&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909/organizer-archive-inventory.json" source="deliverables/control_coverage_20260909/organizer-archive-inventory.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Новые скважины / затраты&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нет произвольной новой геометрии&lt;br&gt;Нет отдельного бурового CAPEX&lt;br&gt;Нет самостоятельных тарифов ремонта&lt;br&gt;водоочистки/электроэнергии/ликвидации&lt;br&gt;Нужны исходные данные и правила начисления&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Будущие квоты и сеть&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Механизм численных лимитов есть&lt;br&gt;Организаторские значения не даны&lt;br&gt;Контроль по месячным точкам&lt;br&gt;Внутримесячные пики не ограничены этим кодом&lt;br&gt;Наземная гидравлика отдельно не моделируется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;operating_constraints.py&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py" source="src/timesoil/aios/operating_constraints.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Суррогат — другой контур&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;В описанном Треке 1 surrogate_used=false&lt;br&gt;BHP-входы добавлены в код Трека 2&lt;br&gt;82 теста +9 подслучаев прошли&lt;br&gt;Новое обучение на OPM ещё впереди&lt;br&gt;Не переносим этот статус на качество Y&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;git: audit-track2-20260909@1cb9d00&lt;/span&gt;" tooltip="git: audit-track2-20260909@1cb9d00" source="git: audit-track2-20260909@1cb9d00"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Критерий механизма&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Параметр сохранён в JSON и SCHEDULE&lt;br&gt;OPM действительно исполняет его&lt;br&gt;Фактические ограничения проверены&lt;br&gt;Официальный ЧДД учитывает событие&lt;br&gt;Есть воспроизводимая квитанция&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Критерий улучшения&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Одинаковая модель и история&lt;br&gt;Одинаковые нормы и весь период&lt;br&gt;ЧДД кандидата выше ЧДД базы&lt;br&gt;Δ% = (candidate/base−1)×100&lt;br&gt;Только новый физический прогон это докажет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;audit_track1_lifecycle.py&lt;/span&gt;" tooltip="scripts/audit_track1_lifecycle.py" source="scripts/audit_track1_lifecycle.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Критерий автономности&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Все месяцы без ручного исправления&lt;br&gt;Нет чтения будущих наблюдений&lt;br&gt;Восстановление корректно и проверено&lt;br&gt;Ошибка внешнего API не скрыта&lt;br&gt;Итоговый график воспроизводим&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/run" source="src/timesoil/aios/track1.py::MonthlyMPC/run"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Легенда всей схемы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Бирюза — код и принятые данные&lt;br&gt;Синий — полная физика OPM&lt;br&gt;Фиолетовый — роль внешнего Qwen&lt;br&gt;Золотой — экономика&lt;br&gt;Оранжевый пунктир — открыто/ограничено&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:01&lt;/span&gt;" tooltip="page:01" source="page:01" link="data:page/pg01"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="сравнение" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="условия рез