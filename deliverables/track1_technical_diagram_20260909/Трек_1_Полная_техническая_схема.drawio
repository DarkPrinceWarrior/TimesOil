py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Происхождение SUMMARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;manifest успешного OPM&lt;br&gt;Точный образ и исходный source&lt;br&gt;extraction manifest и SHA отчёта&lt;br&gt;Проверка фактического извлечения&lt;br&gt;Произвольный CSV не принимается&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;verify_summary_extraction&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::verify_summary_extraction" source="src/timesoil/aios/opm.py::verify_summary_extraction"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Календарь&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;OPM DATE или START + TIME&lt;br&gt;Канонические даты первых чисел&lt;br&gt;Управление t даёт отчёт t+1&lt;br&gt;Результат не сдвигается на будущее&lt;br&gt;Нет дыр в месяце × well&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;opm_management_rows&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::opm_management_rows" source="src/timesoil/aios/economics.py::opm_management_rows"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Единицы состояния агента&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;oil_rate, liquid_rate, injection_rate&lt;br&gt;Все поверхностные м³/сут&lt;br&gt;bhp — бар&lt;br&gt;Они не являются тоннами&lt;br&gt;active определяется реальными потоками&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_wells_at&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_wells_at" source="src/timesoil/aios/opm.py::OpmGdmBackend/_wells_at"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Объём → масса&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нефть: фазовый объём × ρoil&lt;br&gt;Жидкость: oil mass + water mass&lt;br&gt;Плотности из исходного deck/карты&lt;br&gt;Закачка остаётся в м³&lt;br&gt;Нельзя умножать всю жидкость на ρoil&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Поля ЧДД: дата и добыча&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;DATA; well&lt;br&gt;WLPT — накопленная жидкость, т&lt;br&gt;WLPR — объёмный дебит, м³/сут&lt;br&gt;WOMT — накопленная нефть, т&lt;br&gt;WOMR — нефтяной дебит, т/сут&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CHDD_FIELDS&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDD_FIELDS" source="src/timesoil/aios/economics.py::CHDD_FIELDS"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Поля ЧДД: вода и давление&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;WWIR — закачка, м³/сут&lt;br&gt;WWIT — накопленная закачка, м³&lt;br&gt;THP ← WBP9: здесь пластовое давление&lt;br&gt;BHP ← WBHP: забойное давление&lt;br&gt;WEFF — нормализованная эффективность&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Накопленные приращения&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;WLPT_Diff: жидкость за месяц, т&lt;br&gt;WOMT_Diff: нефть за месяц, т&lt;br&gt;WWIT_Diff: закачка за месяц, м³&lt;br&gt;Разность соседних накоплений&lt;br&gt;Отрицательные объёмы → отказ экспорта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Расходы по фактическим объёмам&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Не по заявленным target rates&lt;br&gt;Вода оплачивается и в жидкости&lt;br&gt;Закачка — отдельная статья&lt;br&gt;Накопления сохраняют историю&lt;br&gt;Точность единиц проверяется отдельно&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:08&lt;/span&gt;" tooltip="page:08" source="page:08" link="data:page/pg08"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Принятый период&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Преобразование endpoint → месяц&lt;br&gt;Отчёт 2014-02-01 → 2014-01-01&lt;br&gt;История до старта нужна для событий&lt;br&gt;Будущее после границы отсекается&lt;br&gt;Суммируются только нужные месяцы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;opm_management_rows&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::opm_management_rows" source="src/timesoil/aios/economics.py::opm_management_rows"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Отдельный экспорт траектории&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;scenario_id; source_model; date; well&lt;br&gt;oil_tpd; liquid_tpd; pressure_bar&lt;br&gt;control_value; control_target; status&lt;br&gt;Источник заданий — SCHEDULE&lt;br&gt;В текущем Треке 1 суррогат не используется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Нулевые фазы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нет добычи → нулевая масса&lt;br&gt;Нет деления на нулевую жидкость&lt;br&gt;Нефть не превышает жидкость&lt;br&gt;Нельзя скрывать отрицательные значения&lt;br&gt;Неактивная скважина остаётся в фонде&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Важная неоднозначность THP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Название колонки унаследовано&lt;br&gt;В этих данных THP = WBP9&lt;br&gt;Это не устьевое давление для штуцера&lt;br&gt;THPRES — пороги областей пласта&lt;br&gt;VFP-таблицы в архивах не найдены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экспортный manifest&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Схема/поля и число строк&lt;br&gt;Хэши chdd.csv и trajectory.csv&lt;br&gt;Связь с OPM/extraction manifest&lt;br&gt;Единицы, плотности, преобразования&lt;br&gt;Исходник можно проверить заново&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;export_opm_chdd&lt;/span&gt;" tooltip="src/timesoil/aios/opm_chdd.py::export_opm_chdd" source="src/timesoil/aios/opm_chdd.py::export_opm_chdd"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Потребители&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Официальный ЧДД ← chdd.csv&lt;br&gt;Состояние Sₜ₊₁ ← SUMMARY&lt;br&gt;Критик ← проверенные квитанции&lt;br&gt;Аудитор ← вся связанная цепочка&lt;br&gt;Данные будущего не становятся Sₜ₊₁&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:10&lt;/span&gt;" tooltip="page:10" source="page:10" link="data:page/pg10"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="соединения" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="контракт" edge="1" parent="1" source="b" target="c" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" flow="даты" edge="1" parent="1" source="c" target="d" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" flow="объёмы" edge="1" parent="1" source="e" target="f" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge4" value="" flow="масса" edge="1" parent="1" source="f" target="g" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="" flow="контракт 14 полей" edge="1" parent="1" source="g" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" value="" flow="фактический объём" edge="1" parent="1" source="i" target="j" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge7" value="" flow="период" edge="1" parent="1" source="j" target="k" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge8" value="" flow="экономика" edge="1" parent="1" source="k" target="p" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1145" y="866" /><mxPoint x="1595" y="866" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="" flow="инварианты" edge="1" parent="1" source="m" target="i" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge10" value="" flow="смысл THP" edge="1" parent="1" source="n" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="920" y="981" /><mxPoint x="920" y="635" /><mxPoint x="1595" y="635" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="" flow="CSV" edge="1" parent="1" source="g" target="o" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1366" y="519" /><mxPoint x="1366" y="981" /></Array></mxGeometry></mxCell><mxCell id="edge12" value="" flow="CSV" edge="1" parent="1" source="l" target="o" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1373" y="750" /><mxPoint x="1373" y="981" /></Array></mxGeometry></mxCell><mxCell id="edge13" value="" flow="доказательства" edge="1" parent="1" source="o" target="p" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><object id="foot" label="Трек 1 · 07/12 · Источники: audit-track1-20260909@c088d2d · 09.09.2026 · Полные ссылки в свойствах блока" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=12;fontColor=#52645F;align=left;"><mxGeometry as="geometry" x="40" y="1139" width="1760" height="35" /></mxCell></object></root></mxGraphModel></diagram><diagram id="pg08" name="08 · Официальный ЧДД"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="08 · Официальный ЧДД" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Точные статьи и порядок расчёта. Все деньги ниже — млн рублей, если отдельно не указаны рубли." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Объёмы и события" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Выручка и затраты" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Налоги и денежный поток" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Дисконтирование и сравнение" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Входная нормализация&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;14 полей; полная история скважин&lt;br&gt;Сортировка по well и DATA&lt;br&gt;История ЭЦН до economics_start&lt;br&gt;История активности и переводов&lt;br&gt;Позднее целевого периода отсекается&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;calculate&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate" source="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Фактические объёмы месяца&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нефть Qoil = Σ WOMT_Diff, т&lt;br&gt;Жидкость Qliq = Σ WLPT_Diff, т&lt;br&gt;Закачка Qinj = Σ WWIT_Diff, м³&lt;br&gt;Nactive: WLPR&amp;gt;0 или WWIR&amp;gt;0&lt;br&gt;Нормативы — со страницы 09&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Выручка и отчисления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Revenue = Qoil × 28 000 /10⁶&lt;br&gt;Deductions = Qoil × 19 600 /10⁶&lt;br&gt;Это разные статьи&lt;br&gt;Выручка определяется добычей&lt;br&gt;Заявленное управление денег не создаёт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Эксплуатационные расходы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Oil OPEX = Qoil ×40 /10⁶&lt;br&gt;Liquid OPEX = Qliq ×100 /10⁶&lt;br&gt;Injection OPEX = Qinj ×30 /10⁶&lt;br&gt;Fund = Nactive ×1 000 000 /12 /10⁶&lt;br&gt;Нефть и жидкость оплачиваются обе&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Состояние ЭЦН&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Типоразмер хранится между месяцами&lt;br&gt;Первичный подбор по фактическому WLPR&lt;br&gt;Выше max → насос большего размера&lt;br&gt;min − rate &amp;gt;100 → уменьшение&lt;br&gt;При простое память ЭЦН не обнуляется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_build_pump_history&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::_build_pump_history" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::_build_pump_history"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Затраты на события&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Смена ЭЦН: цена нового насоса CAPEX&lt;br&gt;Работа по смене: 1,8 млн в OPEX&lt;br&gt;Запуск/остановка активности: 1 млн&lt;br&gt;Прямой PROD→INJ: 5 млн&lt;br&gt;Перевод не добавляет фиктивный stop&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_build_conversion_transitions&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::_build_conversion_transitions" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::_build_conversion_transitions"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Имущество и амортизация&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PropertyTax = (Rstart+Rend)/2&lt;br&gt;×2,2% /12&lt;br&gt;Depreciation = annualDepreciation /12&lt;br&gt;В текущем профиле остатки и D =0&lt;br&gt;Новые ЭЦН не капитализируются в базе налога&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Полный OPEX&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нефть + жидкость + закачка + фонд&lt;br&gt;Налог на имущество + работы ЭЦН&lt;br&gt;Запуск/остановка + перевод&lt;br&gt;CAPEX насоса вычитается отдельно&lt;br&gt;Двойной счёт не добавляется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Налогооблагаемая прибыль&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Revenue − OPEX − Depreciation&lt;br&gt;− Deductions − OtherIncluded&lt;br&gt;− OtherExcluded&lt;br&gt;Другие статьи профиля делятся на 12&lt;br&gt;Знаки берутся из официальной методики&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Годовой налог на прибыль&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;AnnualTax = max(0, Σ Taxable) ×25%&lt;br&gt;Распределение по положительной базе&lt;br&gt;месяцев этого календарного года&lt;br&gt;После этого FCF пересчитывается&lt;br&gt;Не простая сумма max(0, месяц)×25%&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Денежный поток&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;EBITDA = Revenue − OPEX&lt;br&gt;− Deductions − OtherIncluded&lt;br&gt;FCF = EBITDA − ProfitTax − CAPEX&lt;br&gt;Отдельно discounted inflow/outflow&lt;br&gt;Амортизация не повторный платёж&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Официальный дисконт&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;DF(year)=1/(1+10%)^max(0,year−start_year)&lt;br&gt;Одинаковый DF внутри года&lt;br&gt;CHDD_month = FCF_month ×DF&lt;br&gt;ЧДД периода = Σ CHDD_month&lt;br&gt;Не заменяется месячным дисконтом&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compute_calculation&lt;/span&gt;" tooltip="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation" source="docs/hackathon/chdd/CHDD_PYTHON/chdd_model.py::compute_calculation"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Вызов калькулятора&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Python РАСЧЕТ_ЧДД.py&lt;br&gt;--input / --norms / --start-year&lt;br&gt;--output report.xlsx / --json result.json&lt;br&gt;Временный каталог → готовый атомарно&lt;br&gt;Ошибки/таймаут/нет файлов → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;calculate&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate" source="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Срез принятого периода&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Расчёт start … t&lt;br&gt;История поддерживает насосные события&lt;br&gt;Будущее не влияет на принятый налог&lt;br&gt;Месячный result — накопленный ЧДД&lt;br&gt;Его нельзя суммировать с предыдущим&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;management_period_summary&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::management_period_summary" source="src/timesoil/aios/economics.py::management_period_summary"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Срез полного плана&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Те же исходники, нормы и start&lt;br&gt;Граница: следующий месяц после end&lt;br&gt;История + текущий + хвост&lt;br&gt;По этому ЧДД выбирается кандидат&lt;br&gt;До принятия это только плановая оценка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Предел экономики&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Отдельных тарифов бурения/ремонта&lt;br&gt;электроэнергии/водоочистки нет&lt;br&gt;Неизвестный норматив отклоняется&lt;br&gt;Не приписываем отсутствующим данным ноль&lt;br&gt;Не меняем официальный калькулятор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="история" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="добыча" edge="1" parent="1" source="b" target="c" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;round