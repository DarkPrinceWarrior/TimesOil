хождение" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Добыча и насосы" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Событийные правила" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Валидация профиля" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Профиль из официального XLSX&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;19 исходных строк Нормативы&lt;br&gt;После defaults: 25 параметров&lt;br&gt;7 обязательных поправок методики&lt;br&gt;12 типоразмеров ЭЦН&lt;br&gt;Всё передаётся планировщику&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;normative_profile&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/normative_profile" source="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/normative_profile"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Цены и переменные OPEX&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;oilPriceRubT = 28 000&lt;br&gt;deductionsRubT = 19 600&lt;br&gt;oilOpexRubT = 40&lt;br&gt;liquidOpexRubT = 100&lt;br&gt;injectionOpexRubM3 = 30&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;Нормативы_ЧДД.xlsx → assumptions&lt;/span&gt;" tooltip="Нормативы_ЧДД.xlsx → assumptions" source="Нормативы_ЧДД.xlsx → assumptions"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Фонд / работы / события&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;fundAnnualRubWell = 1 000 000&lt;br&gt;pumpOperationCostM = 1,8&lt;br&gt;stopStartCostM = 1&lt;br&gt;conversionBaseCostM = 5&lt;br&gt;regimeThreshold = 10&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;Нормативы_ЧДД.xlsx → assumptions&lt;/span&gt;" tooltip="Нормативы_ЧДД.xlsx → assumptions" source="Нормативы_ЧДД.xlsx → assumptions"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Ставки и прочие суммы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;profitTaxRate = 25%; propertyTaxRate=2,2%&lt;br&gt;waccRate = 10%&lt;br&gt;annualDepreciationM = 0&lt;br&gt;otherIncludedEbitdaM = 0&lt;br&gt;otherExcludedEbitda