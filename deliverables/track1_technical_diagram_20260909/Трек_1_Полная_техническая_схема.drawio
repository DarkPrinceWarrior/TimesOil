ogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><object id="foot" label="Трек 1 · 03/12 · Источники: audit-track1-20260909@c088d2d · 09.09.2026 · Полные ссылки в свойствах блока" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=12;fontColor=#52645F;align=left;"><mxGeometry as="geometry" x="40" y="1139" width="1760" height="35" /></mxCell></object></root></mxGraphModel></diagram><diagram id="pg04" name="04 · Управление и ограничения"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="04 · Управление и ограничения" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Два уровня: корректность команд до OPM и проверка фактических потоков после OPM." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Команды скважин" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Канонический график" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Внешние ограничения" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Фактическая проверка" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Отбор и статус&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Добывающая: ORAT или LRAT&lt;br&gt;LRAT ≤500 м³/сут на скважину&lt;br&gt;OPEN/SHUT — решения оператора&lt;br&gt;SHUT → value=0&lt;br&gt;ORAT тоже проверяется по факту WLPR&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;validate&lt;/span&gt;" tooltip="src/timesoil/aios/schedule.py::ScheduleCompiler/validate" source="src/timesoil/aios/schedule.py::ScheduleCompiler/validate"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Компиляция&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Сортировка month / role / well&lt;br&gt;DATES + WCONPROD + WCONINJE&lt;br&gt;Детерминированные числа&lt;br&gt;Обратный parse и сравнение actions&lt;br&gt;SHA-256 точного текста&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;compile&lt;/span&gt;" tooltip="src/timesoil/aios/schedule.py::ScheduleCompiler/compile" source="src/timesoil/aios/schedule.py::ScheduleCompiler/compile"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Простой / ремонт&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;start … end включительно&lt;br&gt;Явный список скважин&lt;br&gt;unavailable=true требует SHUT/0&lt;br&gt;Нулевые фактические потоки после OPM&lt;br&gt;Тарифа ремонта в профиле нет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;check_controls&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py::check_controls" source="src/timesoil/aios/operating_constraints.py::check_controls"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Месячный SUMMARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Для каждого заданного месяца&lt;br&gt;Отчёт t+1 относится к управлению t&lt;br&gt;Полный фонд и METRIC&lt;br&gt;Отсутствие данных → отказ&lt;br&gt;Это отчётные точки, не все пики&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;check_summary&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py::check_summary" source="src/timesoil/aios/operating_constraints.py::check_summary"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Закачка и смена роли&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нагнетательная: WRAT, WATER/RATE&lt;br&gt;PROD→INJ только при разрешении Case&lt;br&gt;Новой закачке нужен потолок BHP&lt;br&gt;INJ→PROD запрещён&lt;br&gt;Роль переносится в следующие месяцы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_propose_controls&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_propose_controls" source="scripts/run_track1_mpc.py::_propose_controls"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;BHP-граница&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;bhp_limit &amp;gt;0, единицы бар&lt;br&gt;Добывающая: можно поднять минимум&lt;br&gt;Нагнетательная: понизить максимум&lt;br&gt;Исходную границу ослаблять нельзя&lt;br&gt;Не THP, не положение штуцера&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;schedule_overlay.py&lt;/span&gt;" tooltip="src/timesoil/aios/schedule_overlay.py" source="src/timesoil/aios/schedule_overlay.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Групповые расходы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;max_oil_m3d&lt;br&gt;max_liquid_m3d&lt;br&gt;max_injection_m3d&lt;br&gt;min_injection_m3d&lt;br&gt;Суммируются по заданной wells[]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;check_observed&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py::check_observed" source="src/timesoil/aios/operating_constraints.py::check_observed"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Фактические дебиты&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;WOPR: нефть, WLPR: жидкость&lt;br&gt;WWIR: закачка, м³/сут&lt;br&gt;Нулевой target не заменяет измерение&lt;br&gt;Превышение границы → отклонение&lt;br&gt;Проверяется и будущая траектория&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Полнота кандидата&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Все 49 скважин ровно один раз&lt;br&gt;Только текущий месяц&lt;br&gt;Нет неизвестных имён или NaN&lt;br&gt;Одинаковые действия → удаление дублей&lt;br&gt;После отбора снова валидация&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_validated_candidates&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_validated_candidates" source="src/timesoil/aios/track1.py::MonthlyMPC/_validated_candidates"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Overlay исходника&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Меняются выбранные WCON-поля&lt;br&gt;Композиция: история + текущий + хвост&lt;br&gt;Геология, PVT и COMPDAT сохранены&lt;br&gt;За границей расчёта ставится остановка&lt;br&gt;source/output/controls SHA-256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_full_replay_schedule&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_full_replay_schedule" source="src/timesoil/aios/opm.py::OpmGdmBackend/_full_replay_schedule"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Вода и давление&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;max_watercut в диапазоне 0…1&lt;br&gt;max(0, 1 − WOPR/WLPR)&lt;br&gt;При нулевой жидкости деления нет&lt;br&gt;min_bhp_bar / max_bhp_bar&lt;br&gt;По каждой работающей скважине&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;check_observed&lt;/span&gt;" tooltip="src/timesoil/aios/operating_constraints.py::check_observed" source="src/timesoil/aios/operating_constraints.py::check_observed"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Неизвестные условия&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Неизвестный ключ или единица → отказ&lt;br&gt;Квота в тоннах требует плотностей&lt;br&gt;Нет численной квоты — нет её выдумки&lt;br&gt;Гидравлика наземной сети не задана&lt;br&gt;Детальный ремонт/бурение не начислены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Предел текущего управления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Произвольная новая геометрия не вводится&lt;br&gt;Имеющийся полный фонд сохраняется&lt;br&gt;Комплектации берутся из исходника&lt;br&gt;THP требует VFP/модели подъёма&lt;br&gt;Новых исходных данных пока нет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;CONTROL_COST_GAPS_20260909.md&lt;/span&gt;" tooltip="docs/CONTROL_COST_GAPS_20260909.md" source="docs/CONTROL_COST_GAPS_20260909.md"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Будущий простой&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Хвост должен быть допустим на весь срок&lt;br&gt;Валидатор не строит план за агента&lt;br&gt;Явный исходный календарь учитывается&lt;br&gt;Нарушение будущей квоты → отказ&lt;br&gt;Ограничение не снимается ради ЧДД&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_continuation_tail&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_continuation_tail" source="scripts/run_track1_mpc.py::_continuation_tail"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Реальная проверка механизма&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Скв. 1: перевод, WRAT 80, BHP 280&lt;br&gt;Скв. 12: LRAT 100, минимум BHP 70&lt;br&gt;Скв. 14: вынужденный простой&lt;br&gt;Два шага + полный плановый период&lt;br&gt;Перевод оплачен ровно один раз&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;operating-constraints-verification.json&lt;/span&gt;" tooltip="deliverables/control_coverage_20260909/operating-constraints-verification.json" source="deliverables/control_coverage_20260909/operating-constraints-verification.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;После проверок&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Допустимый GdmResult&lt;br&gt;Пустой invariant_violations&lt;br&gt;Полный официальный ЧДД&lt;br&gt;Только затем сравнение и критик&lt;br&gt;Проверка механизма ≠ рост ЧДД&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_check_result&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_check_result" source="src/timesoil/aios/track1.py::MonthlyMPC/_check_result"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="actions" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="BHP" edge="1" parent="1" source="e" target="f" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" flow="полнота" edge="1" parent="1" source="i" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="470" y="750" /><mxPoint x="470" y="288" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="" flow="текст" edge="1" parent="1" source="b" target="j" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="916" y="288" /><mxPoint x="916" y="750" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="" flow="календарь" edge="1" parent="1" source="c" target="d" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="" flow="лимиты" edge="1" parent="1" source="g" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" value="" flow="доля/давление" edge="1" parent="1" source="k" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1145" y="642" /><mxPoint x="1595" y="642" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="" flow="OPM" edge="1" parent="1" source="j" target="h" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="695" y="628" /><mxPoint x="1595" y="628" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="" flow="допустимо" edge="1" parent="1" source="h" target="p" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1816" y="519" /><mxPoint x="1816" y="981" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="" flow="хвост" edge="1" parent="1" source="n" target="j" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge10" value="" flow="контрольный опыт" edge="1" parent="1" source="o" target="p" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><object id="foot" label="Трек 1 · 04/12 · Источники: audit-track1-20260909@c088d2d · 09.09.2026 · Полные ссылки в свойствах блока" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=12;fontColor=#52645F;align=left;"><mxGeometry as="geometry" x="40" y="1139" width="1760" height="35" /></mxCell></object></root></mxGraphModel></diagram><diagram id="pg05" name="05 · Месячный MPC и горизонт"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="05 · Месячный MPC и горизонт" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Uₜ влияет на Sₜ₊₁. Планирование смотрит до конца Case, но принятие сдвигает время ровно на один месяц." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Начало месяца" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Пара вариантов" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Физическая оценка" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Выбор и перенос" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Месяц t, состояние Sₜ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;month == текущий месяц цикла&lt;br&gt;Проверенная история U₀…Uₜ₋₁&lt;br&gt;Весь фонд и разрешённые роли&lt;br&gt;case.economics_start фиксирован&lt;br&gt;Чужое состояние → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/run" source="src/timesoil/aios/track1.py::MonthlyMPC/run"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Действующий вариант&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Первый месяц: исходный baseline&lt;br&gt;Далее: предыдущие принятые controls&lt;br&gt;Явные смены исходного календаря&lt;br&gt;могут заменить перенесённую команду&lt;br&gt;Перевод в INJ не обращается назад&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Предложение Qwen&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Один complete field candidate&lt;br&gt;Пустые изменения → тот же вариант&lt;br&gt;Область всех скважин доступна&lt;br&gt;Нет заранее выбранного подмножества&lt;br&gt;Нет заявления глобальной оптимальности&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Очистить список&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Каноническая валидация&lt;br&gt;Удалить одинаковые кандидаты&lt;br&gt;Не менее одного допустимого&lt;br&gt;Не более 2 одновременных оценок&lt;br&gt;Ошибка одного не обнуляет другой&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_select&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_select" source="src/timesoil/aios/track1.py::MonthlyMPC/_select"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;История фиксирована&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Предыдущие принятые controls&lt;br&gt;Проверены через цепочку lineage&lt;br&gt;Даты строго меньше t&lt;br&gt;Одинаковая история для двух вариантов&lt;br&gt;Исходник модели неизменен&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_authenticated_history&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history" source="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Продолжение каждого варианта&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Начать с Uₜ данного кандидата&lt;br&gt;На t+1…end переносить controls&lt;br&gt;Явное изменение source calendar — override&lt;br&gt;Роль INJ сохраняется&lt;br&gt;Хвост покрывает месяц × well без дыр&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_continuation_tail&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_continuation_tail" source="scripts/run_track1_mpc.py::_continuation_tail"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Полный план на оценку&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;История + текущий месяц + хвост&lt;br&gt;OPM от начала исходной модели&lt;br&gt;Одна траектория до case.end+1 месяц&lt;br&gt;Два кандидата независимы по файлам&lt;br&gt;CPU-параллельность, не две LLM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_select&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_select" source="src/timesoil/aios/track1.py::MonthlyMPC/_select"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Две экономические оценки&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;economics: start … t включительно&lt;br&gt;planning_economics: start … case.end&lt;br&gt;История насосов учитывается в обеих&lt;br&gt;Будущая добыча не попадает в принятую часть&lt;br&gt;Последний месяц: оценки совпадают&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверка результата&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Сертифицированная полная ГДМ&lt;br&gt;Ожидаемые actions и следующий месяц&lt;br&gt;ЧДД связан с тем же run_id&lt;br&gt;Planning end == next_month(case.end)&lt;br&gt;Нет нарушений инвариантов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_check_result&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_check_result" source="src/timesoil/aios/track1.py::MonthlyMPC/_check_result"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Выбрать argmax&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Ключ №1: полный planning ЧДД&lt;br&gt;Ключ №2: канонический action key&lt;br&gt;Только среди прошедших проверки&lt;br&gt;Нет ни одного → CertificationError&lt;br&gt;Проигравшие артефакты сохраняются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_select&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_select" source="src/timesoil/aios/track1.py::MonthlyMPC/_select"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверить критиком&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;on_step(best) до state=next_state&lt;br&gt;Обязательные квитанции&lt;br&gt;Повторный отказ останавливает цикл&lt;br&gt;Физическая сертификация уже пройдена&lt;br&gt;Принятие месяца ещё ожидает критика&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;review&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/review" source="scripts/run_track1_mpc.py::execute/review"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Перенести один месяц&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;accepted_actions += выбранный Uₜ&lt;br&gt;trajectory и economics в Evidence&lt;br&gt;state = выбранный Sₜ₊₁&lt;br&gt;t = next_month(t)&lt;br&gt;Плановые будущие состояния отбрасываются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/run" source="src/timesoil/aios/track1.py::MonthlyMPC/run"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Информационная граница&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Для нового предложения: Sₜ и прошлое&lt;br&gt;Фактическое будущее не выдаётся агенту&lt;br&gt;Будущий календарь известен как условие&lt;br&gt;Контрфактическое будущее даёт OPM&lt;br&gt;После шага доступен только его результат&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;choose&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/choose" source="scripts/run_track1_mpc.py::execute/choose"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экономическая граница&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Принятая часть: [start, t+1)&lt;br&gt;План: [start, end+1)&lt;br&gt;Отчёт на 1 февраля → январь&lt;br&gt;Итог: последний накопленный ЧДД&lt;br&gt;Сумма step_economics ошибочна&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;opm_management_rows&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::opm_management_rows" source="src/timesoil/aios/economics.py::opm_management_rows"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Цена полного пересчёта&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Каждый месяц снова весь горизонт&lt;br&gt;До двух полных OPM на решение&lt;br&gt;Нет доказанного бинарного restart&lt;br&gt;Стоимость растёт с периодом и фондом&lt;br&gt;Это текущая проверенная реализация&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;OpmGdmBackend&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend" source="src/timesoil/aios/opm.py::OpmGdmBackend"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Завершение&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Все месяцы start…end пройдены&lt;br&gt;Полный график из принятых команд&lt;br&gt;Финальный manifest и его SHA-256&lt;br&gt;Отдельный lifecycle-аудит&lt;br&gt;Метрики качества не заменяют аудит&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:11&lt;/span&gt;" tooltip="page:11" source="page:11" link="data:page/pg11"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="903" width="410" height="156" /></mxCell></object><mxCell id="edge0" value="" flow="Sₜ" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;ortho