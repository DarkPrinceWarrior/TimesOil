ell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверить исходник&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;source SHA-256 до подготовки&lt;br&gt;ZIP/директория/DATA&lt;br&gt;Безопасная распаковка и пути&lt;br&gt;Новая изолированная run_dir&lt;br&gt;Исходные файлы не редактируются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;prepare&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmFlowRunner/prepare" source="src/timesoil/aios/opm.py::OpmFlowRunner/prepare"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Подготовить Model Y&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нормализация исходного кейса Y&lt;br&gt;Установка SUMMARY overlay&lt;br&gt;Список скважин и соединений&lt;br&gt;METRIC/FIELD фиксируется в контракте&lt;br&gt;Изменения описаны в manifest&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;prepare&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmFlowRunner/prepare" source="src/timesoil/aios/opm.py::OpmFlowRunner/prepare"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Привязать старое состояние&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Базовый manifest либо lineage.json&lt;br&gt;Проверить ссылку + SHA-256&lt;br&gt;Источник, образ, артефакты, состояние&lt;br&gt;Проверить всю принятую историю&lt;br&gt;Любая подмена → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_authenticated_history&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history" source="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Составить simulated actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;accepted = история + текущие actions&lt;br&gt;simulated = accepted + planning_tail&lt;br&gt;Хвост не попадает в accepted&lt;br&gt;Каждая оставшаяся well × month есть&lt;br&gt;Операционные лимиты проверены заранее&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Идентификатор расчёта&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Хэш case, restart_ref, source&lt;br&gt;Текущие actions + planning_tail&lt;br&gt;Planning end и внешние ограничения&lt;br&gt;opm-full-replay-&amp;lt;24 символа&amp;gt;&lt;br&gt;Не допускается переиспользование run_dir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Точный текст графика&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Из исходного SCHEDULE&lt;br&gt;Подстановка принятого/текущего/хвоста&lt;br&gt;Граница расчёта по следующей дате&lt;br&gt;schedule-overlay.json&lt;br&gt;source/output/controls SHA-256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_full_replay_schedule&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_full_replay_schedule" source="src/timesoil/aios/opm.py::OpmGdmBackend/_full_replay_schedule"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Docker OPM Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Pinned image digest&lt;br&gt;--network=none; /case readonly&lt;br&gt;/output — отдельный writable каталог&lt;br&gt;--threads-per-process=8 в прогонах&lt;br&gt;--parsing-strictness=low явно записан&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_run_prepared&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmFlowRunner/_run_prepared" source="src/timesoil/aios/opm.py::OpmFlowRunner/_run_prepared"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Выход и ошибки&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;returncode=0 нужен для успеха&lt;br&gt;stdout.log / stderr.log&lt;br&gt;Timeout → cleanup своего контейнера&lt;br&gt;OPM manifest: команда, время, артефакты&lt;br&gt;Изменение исходника → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_run_prepared&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmFlowRunner/_run_prepared" source="src/timesoil/aios/opm.py::OpmFlowRunner/_run_prepared"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Физика внутри OPM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Исходная сетка и свойства пород&lt;br&gt;PVT, флюиды, начальные условия&lt;br&gt;Потоки между ячейками и скважинами&lt;br&gt;Давление и обводнение&lt;br&gt;Влияние закачки на соседние скважины&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;INCLUDE + OPM Flow&lt;/span&gt;" tooltip="организаторский DATA/INCLUDE + OPM Flow" source="организаторский DATA/INCLUDE + OPM Flow"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Извлечение SUMMARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;summary-report.txt&lt;br&gt;summary-extraction.json&lt;br&gt;Повторное проверяемое извлечение&lt;br&gt;Well- и connection-векторы&lt;br&gt;Хэши отчёта и бинарных источников&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;verify_summary_extraction&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::verify_summary_extraction" source="src/timesoil/aios/opm.py::verify_summary_extraction"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверить реальный результат&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Полнота отчётных дат и фонда&lt;br&gt;Фактический WLPR ≤500&lt;br&gt;Квоты/простой/вода/давление&lt;br&gt;Проверка будущей плановой части&lt;br&gt;Ошибку нельзя исправить текстом LLM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Взять Sₜ₊₁&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;_wells_at(report, next_month)&lt;br&gt;Роли: state + выбранные actions&lt;br&gt;WOPR, WLPR, WWIR, WBHP&lt;br&gt;Нельзя брать состояние конца хвоста&lt;br&gt;Только следующий месячный отчёт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_wells_at&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_wells_at" source="src/timesoil/aios/opm.py::OpmGdmBackend/_wells_at"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Что не делает агент&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Не решает уравнения фильтрации&lt;br&gt;Не меняет геологию или плотности&lt;br&gt;Не подставляет прогноз в SUMMARY&lt;br&gt;Не выдаёт LLM-оценку за ЧДД&lt;br&gt;Не обходит ошибку симулятора&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_check_result&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/_check_result" source="src/timesoil/aios/track1.py::MonthlyMPC/_check_result"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Канонические данные&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;canonical/chdd.csv — экономика&lt;br&gt;canonical/trajectory.csv — экспорт&lt;br&gt;canonical/manifest.json — происхождение&lt;br&gt;Оба файла из одного SUMMARY&lt;br&gt;Подробности в странице 07&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:07&lt;/span&gt;