metry as="geometry" x="40" y="1316" width="1760" height="35" /></mxCell></object></root></mxGraphModel></diagram><diagram id="pg10" name="10 · Lineage и восстановление"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="10 · Lineage и восстановление" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Повторный запуск доверяет только непрерывному одобренному префиксу, подтверждённому физическими квитанциями." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Квитанция месяца" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="Проверка цепочки" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Журнал агента" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Продолжение" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Начальная restart_ref&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Базовый OPM manifest + SHA-256&lt;br&gt;Образ и source проверены&lt;br&gt;SUMMARY воспроизводимо извлечён&lt;br&gt;S₀ совпадает с данным отчёта&lt;br&gt;Принятых изменений ещё нет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_authenticated_history&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history" source="src/timesoil/aios/opm.py::OpmGdmBackend/_authenticated_history"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;lineage каждого кандидата&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;prior_restart_ref; input_state&lt;br&gt;step_actions; accepted_actions&lt;br&gt;next_state; economics; artifacts&lt;br&gt;planning_tail и planning_end&lt;br&gt;Хэш содержимого + sidecar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Журнал JSONL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Каждый этап дописывается&lt;br&gt;flush + fsync после записи&lt;br&gt;Решения ролей и tool_evidence&lt;br&gt;Отказы тоже остаются в истории&lt;br&gt;Не редактируется для видимости успеха&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;record&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute/record" source="scripts/run_track1_mpc.py::execute/record"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;--resume-log&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Допустим только --lifecycle&lt;br&gt;И физический OpmGdmBackend&lt;br&gt;Точный source и начальное состояние&lt;br&gt;Новый запуск хранит SHA старого лога&lt;br&gt;Исходный журнал сохраняется целиком&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_resume_steps&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_resume_steps" source="scripts/run_track1_mpc.py::_resume_steps"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверить каждый файл&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Без symlink/path traversal&lt;br&gt;Ссылки внутри run_dir&lt;br&gt;SHA-256 артефактов&lt;br&gt;OPM manifest success + pinned digest&lt;br&gt;Смена исходника → отказ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_verify_lineage_artifacts&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_verify_lineage_artifacts" source="src/timesoil/aios/opm.py::OpmGdmBackend/_verify_lineage_artifacts"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Проверить происхождение&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Предыдущая ссылка совпадает&lt;br&gt;input_state == прежний S&lt;br&gt;next_state совпадает с квитанцией&lt;br&gt;История повторяется без подмен&lt;br&gt;Циклы и будущие controls запрещены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_history_from_lineage&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/_history_from_lineage" source="src/timesoil/aios/opm.py::OpmGdmBackend/_history_from_lineage"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;Сопоставить plan и review&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;План одобрен всеми ролями&lt;br&gt;Состояние плана совпадает с текущим&lt;br&gt;terminal_month_review одобрен&lt;br&gt;Обязательное tool_evidence есть&lt;br&gt;Месяц и source совпадают&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_resume_steps&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_resume_steps" source="scripts/run_track1_mpc.py::_resume_steps"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;Сверить физику и деньги&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;_check_result для каждого шага&lt;br&gt;Точный ЧДД == economics в lineage&lt;br&gt;Полный ЧДД/граница тоже совпадают&lt;br&gt;accepted_actions совпадают с историей&lt;br&gt;future_states_committed=false&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_resume_steps&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_resume_steps" source="scripts/run_track1_mpc.py::_resume_steps"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Что не является принятием&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Один успешный OPM ещё не месяц цикла&lt;br&gt;Кандидат мог проиграть сравнение&lt;br&gt;Критик мог отклонить результат&lt;br&gt;Полный хвост не является принятым&lt;br&gt;Нужен одобренный непрерывный префикс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_resume_steps&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_resume_steps" source="scripts/run_track1_mpc.py::_resume_steps"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Граница восстановления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Первый неодобренный review — стоп&lt;br&gt;Оборванные/неполные этапы не переносятся&lt;br&gt;Нет одобренных месяцев → отказ&lt;br&gt;Лишний префикс за end → отказ&lt;br&gt;Все оставшиеся записи остаются в source log&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_resume_steps&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_resume_steps" source="scripts/run_track1_mpc.py::_resume_steps"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Восстановить оперативную память&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;previous_controls из принятых actions&lt;br&gt;feedback из принятых состояний&lt;br&gt;completed_steps → MonthlyMPC.run&lt;br&gt;Пройденные месяцы не переоцениваются&lt;br&gt;Критик повторно для них не вызывается&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;execute&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute" source="scripts/run_track1_mpc.py::execute"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Продолжить первый новый месяц&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Проверить границу state.month&lt;br&gt;Вызвать Qwen с восстановленным прошлым&lt;br&gt;Снова incumbent + proposal&lt;br&gt;Полный OPM и ЧДД&lt;br&gt;Новый on_step критика&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run&lt;/span&gt;" tooltip="src/timesoil/aios/track1.py::MonthlyMPC/run" source="src/timesoil/aios/track1.py::MonthlyMPC/run"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Доказанный запуск Y&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;После 12 месяцев отказ планировщика&lt;br&gt;После 20 месяцев HTTP 400 API&lt;br&gt;Продолжения с проверкой префикса&lt;br&gt;Итог: все 23 месяца завершены&lt;br&gt;Это не запуск без вмешательств&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;lifecycle-audit.json&lt;/span&gt;" tooltip="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json" source="deliverables/track1_model_y/full_horizon_20260909/lifecycle-audit.json"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Область времени агента&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;elapsed_seconds у resumed запуска&lt;br&gt;Относится к текущему вызову&lt;br&gt;Не суммарное время всей цепочки&lt;br&gt;Предыдущие LLM-вызовы сохранены в логах&lt;br&gt;Число 674,50 с — только последнее продолжение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;execute&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::execute" source="scripts/run_track1_mpc.py::execute"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Аудит всей цепочки&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;23 месяца и 49 скважин&lt;br&gt;1 127 принятых команд&lt;br&gt;364 связанных файла проверено&lt;br&gt;История до управления одинакова&lt;br&gt;График и manifest имеют SHA-256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;audit_track1_lifecycle.py&lt;/span&gt;" tooltip="scripts/audit_track1_lifecycle.py" source="scripts/audit_track1_lifecycle.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="903" width="410" height="156" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Финальная гарантия&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Можно проследить каждый принятый шаг&lt;br&gt;От графика до OPM и официального ЧДД&lt;br&gt;Нельзя незаметно заменить одну квитанцию&lt;br&gt;Физические файлы остаются на A100&lt;br&gt;Схема не заменяет сами доказательства&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:11&lt;/span&gt;" tooltip="page:11" source="page:11" link="data:page/pg11"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFami