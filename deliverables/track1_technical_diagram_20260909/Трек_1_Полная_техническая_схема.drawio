t><object id="subtitle" label="Карта артефактов и инфраструктуры. Редактирование WSL → Git → A100 только fast-forward." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="Оператор / WSL" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="A100 / оркестрация" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="Каталог одного OPM" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="Итоговая поставка" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;Разработка в WSL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;TimesOil-audit-track1&lt;br&gt;Ветка audit-track1-20260909&lt;br&gt;Снимок схемы: c088d2d&lt;br&gt;Текущий main содержит другую ветку&lt;br&gt;Изменения между треками переносятся явно&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;git: audit-track1-20260909@c088d2d&lt;/span&gt;" tooltip="git: audit-track1-20260909@c088d2d" source="git: audit-track1-20260909@c088d2d"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="156" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;Доставка кода&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;git commit → git push&lt;br&gt;A100: git pull --ff-only&lt;br&gt;Научные прогоны выполняются на сервере&lt;br&gt;Из дома: SSH a100-remote&lt;br&gt;Исходники A100 вручную не редактируются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;AGENTS.md + текущие инструкции пользователя&lt;/span&gt;" tooltip="AGENTS.md + текущие инструкции пользователя" source="AGENTS.md + текущие инструкции пользователя"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="156" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;Запуск Трека 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;scripts/run_track1_mpc.py&lt;br&gt;Вход: case.json + output-dir&lt;br&gt;--agent --full-field --lifecycle&lt;br&gt;При продолжении: --resume-log&lt;br&gt;LLM-настройки берутся из окружения&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;_parser&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::_parser" source="scripts/run_track1_mpc.py::_parser"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="156" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;Внешние зависимости&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Cerebras Qwen по HTTPS&lt;br&gt;OPM Flow — pinned Docker image&lt;br&gt;Официальный Python ЧДД&lt;br&gt;API-секрет хранится вне артефактов&lt;br&gt;LLM и OPM имеют отдельные таймауты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;llm.py + opm.py + economics.py&lt;/span&gt;" tooltip="src/timesoil/aios/llm.py + opm.py + economics.py" source="src/timesoil/aios/llm.py + opm.py + economics.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="156" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;Входы запуска&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;case.json; launch.json&lt;br&gt;source ZIP + SHA-256&lt;br&gt;Начальная квитанция OPM&lt;br&gt;Нормативы_ЧДД.xlsx и код калькулятора&lt;br&gt;Прежний agent.jsonl при resume&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;load_config&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::load_config" source="scripts/run_track1_mpc.py::load_config"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="441" width="410" height="156" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;Каталог управления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;results/audit-20260909/…&lt;br&gt;delivery/track1-&amp;lt;hash&amp;gt;/&lt;br&gt;agent.jsonl рядом с выдачей&lt;br&gt;stdout.log; stderr.log&lt;br&gt;Исходные отказы не удаляются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;main&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::main" source="scripts/run_track1_mpc.py::main"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="441" width="410" height="156" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;OPM: входы и выходы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;input/ — snapshot DATA/INCLUDE&lt;br&gt;output/ — бинарные результаты Flow&lt;br&gt;manifest.json — запуск и хэши&lt;br&gt;schedule-overlay.json&lt;br&gt;stdout.log; stderr.log&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;OpmFlowRunner&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmFlowRunner" source="src/timesoil/aios/opm.py::OpmFlowRunner"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="441" width="410" height="156" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;OPM: доказательства&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;summary-report.txt&lt;br&gt;summary-extraction.json&lt;br&gt;canonical/chdd.csv&lt;br&gt;canonical/trajectory.csv + manifest.json&lt;br&gt;lineage.json + lineage.sha256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;OpmGdmBackend&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend" source="src/timesoil/aios/opm.py::OpmGdmBackend"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="1390" y="441" width="410" height="156" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экономика принятой части&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;economics/input.csv&lt;br&gt;economics/result.json&lt;br&gt;economics/report.xlsx&lt;br&gt;economics/manifest.json&lt;br&gt;Нормы/исходники имеют хэши&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;calculate&lt;/span&gt;" tooltip="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate" source="src/timesoil/aios/economics.py::CHDDEconomicsAdapter/calculate"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="672" width="410" height="156" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экономика полного плана&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;planning-economics/…&lt;br&gt;Те же четыре файла&lt;br&gt;Период до case.end включительно&lt;br&gt;На последнем шаге повтор не нужен&lt;br&gt;Полный ЧДД записан в lineage.planning&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;run_from_restart&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart" source="src/timesoil/aios/opm.py::OpmGdmBackend/run_from_restart"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="672" width="410" height="156" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;Финальная выдача&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;wells_schedule.inc — все выбранные U&lt;br&gt;result.json — состояния/ЧДД/агент&lt;br&gt;manifest.json — хэши и source contract&lt;br&gt;manifest.sha256 — хэш манифеста&lt;br&gt;Запись новых файлов атомарна&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;publish&lt;/span&gt;" tooltip="scripts/run_track1_mpc.py::publish" source="scripts/run_track1_mpc.py::publish"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="672" width="410" height="156" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;Независимая сверка&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;scripts/audit_track1_lifecycle.py&lt;br&gt;Все месяцы, фонд, график, lineage&lt;br&gt;Парная база: те же периоды/история&lt;br&gt;Нет суммы накопленных step ЧДД&lt;br&gt;lifecycle-audit.json&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;audit_track1_lifecycle.py&lt;/span&gt;" tooltip="scripts/audit_track1_lifecycle.py" source="scripts/audit_track1_lifecycle.py"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="672" width="410" height="156" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Что передаётся на сдачу&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Канонический wells_schedule.inc&lt;br&gt;Объяснение архитектуры и запуска&lt;br&gt;Доказательства происхождения&lt;br&gt;Фактический ЧДД и честные ограничения&lt;br&gt;Большие raw/бинарники остаются вне Git&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;full_horizon_20260909&lt;/span&gt;" tooltip="deliverables/track1_model_y/full_horizon_20260909" source="deliverables/track1_model_y/full_horizon_20260909"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="903" width="410" height="156" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Что проверять при новом кейсе&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Фонд, даты, комплектации и единицы&lt;br&gt;Начальное состояние из новой ГДМ&lt;br&gt;Нормативы и методика&lt;br&gt;Численные внешние ограничения&lt;br&gt;Не переносить чужие хэши как подтверждение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;validate_case&lt;/span&gt;" tooltip="src/timesoil/aios/opm.py::OpmGdmBackend/validate_case" source="src/timesoil/aios/opm.py::OpmGdmBackend/validate_case"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="490" y="903" width="410" height="156" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Ресурсы текущих прогонов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;OPM использует CPU&lt;br&gt;До 2 кандидатов одновременно&lt;br&gt;8 потоков на OPM в доказательных запусках&lt;br&gt;Qwen работает во внешнем API&lt;br&gt;Чужие сервисы A100 не вытесняются&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;AGENTS.md; launch.json; OpmF