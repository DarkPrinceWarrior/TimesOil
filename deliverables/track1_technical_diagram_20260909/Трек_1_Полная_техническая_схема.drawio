<mxfile host="app.diagrams.net" agent="drawio-mcp 1.5.0 / TimesOil" version="29.0.3" pages="12"><diagram id="pg01" name="01 · Полный контур"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="title" label="01 · Полный контур" tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#164E45;align=left;"><mxGeometry as="geometry" x="40" y="20" width="1760" height="48" /></mxCell></object><object id="subtitle" label="Трек 1 · Model Y · текущая реализация c088d2d · 23 месяца / 49 скважин. Порядок основного процесса: блоки 01–12 и стрелки." tooltip="" source=""><mxCell vertex="1" parent="1" style="text;html=1;fontSize=15;fontColor=#36504B;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="40" y="75" width="1760" height="60" /></mxCell></object><object id="lane0" label="1 · Начало строки" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="40" y="145" width="410" height="38" /></mxCell></object><object id="lane1" label="2 · Следующий этап" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="490" y="145" width="410" height="38" /></mxCell></object><object id="lane2" label="3 · Следующий этап" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="940" y="145" width="410" height="38" /></mxCell></object><object id="lane3" label="4 · Продолжение ниже" tooltip="" source=""><mxCell vertex="1" parent="1" style="rounded=1;html=1;fillColor=#164E45;strokeColor=#164E45;fontColor=#FFFFFF;fontSize=15;fontStyle=1;"><mxGeometry as="geometry" x="1390" y="145" width="410" height="38" /></mxCell></object><object id="a" label="&lt;b style=&quot;font-size:16px&quot;&gt;01. Организаторский комплект&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Model Y ZIP: DATA + INCLUDE&lt;br&gt;Геология, PVT, начальные условия&lt;br&gt;WELSPECS / COMPDAT / SCHEDULE&lt;br&gt;Официальные XLSX и Python ЧДД&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:02&lt;/span&gt;" tooltip="page:02" source="page:02" link="data:page/pg02"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="40" y="210" width="410" height="138" /></mxCell></object><object id="b" label="&lt;b style=&quot;font-size:16px&quot;&gt;02. Проверенный Sₜ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;case_id, month, 49 WellState&lt;br&gt;Дебиты, закачка, BHP, active, role&lt;br&gt;restart_ref → квитанция + SHA-256&lt;br&gt;Только состояние на начало месяца&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:02&lt;/span&gt;" tooltip="page:02" source="page:02" link="data:page/pg02"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="490" y="210" width="410" height="138" /></mxCell></object><object id="c" label="&lt;b style=&quot;font-size:16px&quot;&gt;03. Контекст решения&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Sₜ + 3 прошлых принятых месяца&lt;br&gt;Текущий план и полный фонд&lt;br&gt;Все действующие нормативы&lt;br&gt;Ограничения, календарь до конца&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:03&lt;/span&gt;" tooltip="page:03" source="page:03" link="data:page/pg03"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="940" y="210" width="410" height="138" /></mxCell></object><object id="d" label="&lt;b style=&quot;font-size:16px&quot;&gt;04. Qwen предлагает Uₜ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Cerebras: qwen-3.8-27b&lt;br&gt;Координатор → аналитик → планировщик&lt;br&gt;Один вызов propose_controls&lt;br&gt;Типизированные изменения скважин&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:03&lt;/span&gt;" tooltip="page:03" source="page:03" link="data:page/pg03"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="1390" y="210" width="410" height="138" /></mxCell></object><object id="e" label="&lt;b style=&quot;font-size:16px&quot;&gt;05. Проверка управления&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Полный фонд и точный месяц&lt;br&gt;OPEN/SHUT, ORAT/LRAT/WRAT&lt;br&gt;BHP-границы; разрешённые переводы&lt;br&gt;Недопустимый ввод → отказ/исправление&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:04&lt;/span&gt;" tooltip="page:04" source="page:04" link="data:page/pg04"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="423" width="410" height="138" /></mxCell></object><object id="f" label="&lt;b style=&quot;font-size:16px&quot;&gt;06. Два полных плана&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Действующий вариант + предложение&lt;br&gt;История принята и зафиксирована&lt;br&gt;Uₜ + продолжение до конца кейса&lt;br&gt;Одинаковые исходные файлы и период&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:05&lt;/span&gt;" tooltip="page:05" source="page:05" link="data:page/pg05"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="423" width="410" height="138" /></mxCell></object><object id="g" label="&lt;b style=&quot;font-size:16px&quot;&gt;07. OPM Flow × кандидаты&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;До двух кандидатов параллельно&lt;br&gt;Полный повтор расчёта от исходника&lt;br&gt;История + Uₜ + будущий план&lt;br&gt;Нативный бинарный RESTART не используется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:06&lt;/span&gt;" tooltip="page:06" source="page:06" link="data:page/pg06"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="490" y="423" width="410" height="138" /></mxCell></object><object id="h" label="&lt;b style=&quot;font-size:16px&quot;&gt;08. SUMMARY → ЧДД&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Дебиты и накопленные объёмы&lt;br&gt;Плотности → добыча в тоннах&lt;br&gt;Официальный Python-калькулятор&lt;br&gt;Принятая часть и весь горизонт отдельно&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:07&lt;/span&gt;" tooltip="page:07" source="page:07" link="data:page/pg07"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="40" y="423" width="410" height="138" /></mxCell></object><object id="i" label="&lt;b style=&quot;font-size:16px&quot;&gt;09. Детерминированный выбор&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Отбрасываются невалидные траектории&lt;br&gt;Выбирается максимальный полный ЧДД&lt;br&gt;При равенстве — ключ управления&lt;br&gt;Исчерпывающий поиск не заявляется&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:05&lt;/span&gt;" tooltip="page:05" source="page:05" link="data:page/pg05"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="40" y="636" width="410" height="138" /></mxCell></object><object id="j" label="&lt;b style=&quot;font-size:16px&quot;&gt;10. Критик читает доказательства&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;verify_month_evidence обязателен&lt;br&gt;OPM, ЧДД, ограничения, хэши&lt;br&gt;Отказ → одна повторная проверка&lt;br&gt;Повторный отказ останавливает цикл&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:03&lt;/span&gt;" tooltip="page:03" source="page:03" link="data:page/pg03"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F3EDFB;strokeColor=#7656A5;fontSize=14;"><mxGeometry as="geometry" x="490" y="636" width="410" height="138" /></mxCell></object><object id="k" label="&lt;b style=&quot;font-size:16px&quot;&gt;11. Принять только месяц t&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Добавить выбранные Uₜ в историю&lt;br&gt;Sₜ₊₁ берётся из отчёта OPM&lt;br&gt;Будущие состояния не принимаются&lt;br&gt;Хвост заново строится в следующем шаге&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:10&lt;/span&gt;" tooltip="page:10" source="page:10" link="data:page/pg10"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#E7F6F1;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="636" width="410" height="138" /></mxCell></object><object id="l" label="&lt;b style=&quot;font-size:16px&quot;&gt;12. Конец периода?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Нет → новый контекст для t+1&lt;br&gt;Да → полный wells_schedule.inc&lt;br&gt;result.json + manifest + SHA-256&lt;br&gt;Аудит всех месяцев и цепочек&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:11&lt;/span&gt;" tooltip="page:11" source="page:11" link="data:page/pg11"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#9B761D;fontSize=14;"><mxGeometry as="geometry" x="1390" y="636" width="410" height="138" /></mxCell></object><object id="m" label="&lt;b style=&quot;font-size:16px&quot;&gt;Физическое состояние&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Пласты, насыщенности и давление&lt;br&gt;Восстанавливает полный OPM replay&lt;br&gt;LLM не хранит скрытое состояние пласта&lt;br&gt;LLM не вычисляет дебиты вместо OPM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:06&lt;/span&gt;" tooltip="page:06" source="page:06" link="data:page/pg06"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#EAF3FF;strokeColor=#346A9B;fontSize=14;"><mxGeometry as="geometry" x="40" y="849" width="410" height="138" /></mxCell></object><object id="n" label="&lt;b style=&quot;font-size:16px&quot;&gt;Экономическая цель&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;ЧДД по официальной методике&lt;br&gt;События ЭЦН, воды, фонда, налоги&lt;br&gt;Последний накопленный ЧДД — итог&lt;br&gt;Нельзя суммировать накопленные значения&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:08&lt;/span&gt;" tooltip="page:08" source="page:08" link="data:page/pg08"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF4D9;strokeColor=#9E7824;fontSize=14;"><mxGeometry as="geometry" x="490" y="849" width="410" height="138" /></mxCell></object><object id="o" label="&lt;b style=&quot;font-size:16px&quot;&gt;Доказанный полный Y&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;23 месяца: 2014-01 … 2015-11&lt;br&gt;49 скважин; 1 127 команд&lt;br&gt;364 файла проверено; 23 критика&lt;br&gt;ЧДД 1 030,883174 млн; прирост 0%&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:12&lt;/span&gt;" tooltip="page:12" source="page:12" link="data:page/pg12"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#F0FAF7;strokeColor=#207567;fontSize=14;"><mxGeometry as="geometry" x="940" y="849" width="410" height="138" /></mxCell></object><object id="p" label="&lt;b style=&quot;font-size:16px&quot;&gt;Что ещё не доказано&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;THP/штуцеры и произвольное бурение&lt;br&gt;Новый набор воздействий на всех 23 шагах&lt;br&gt;Безотказность внешнего API&lt;br&gt;Трек 1 работает без суррогата&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#52645F&quot;&gt;page:12&lt;/span&gt;" tooltip="page:12" source="page:12" link="data:page/pg12"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#132C2A;strokeWidth=1.4;spacing=14;align=left;verticalAlign=top;fillColor=#FFF0E4;strokeColor=#BE672A;fontSize=14;dashed=1;"><mxGeometry as="geometry" x="1390" y="849" width="410" height="138" /></mxCell></object><mxCell id="edge0" value="" flow="подготовка" edge="1" parent="1" source="a" target="b" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" flow="наблюдения" edge="1" parent="1" source="b" target="c" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="" flow="контекст" edge="1" parent="1" source="c" target="d" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="" flow="JSON" edge="1" parent="1" source="d" target="e" style="endArrow=block;endFill=1;strokeColor=#567A71;strokeWidth=1.4;fontSize=11;fontColor=#36504B;labelBackgroundColo