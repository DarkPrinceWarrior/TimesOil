e=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="90" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="mark1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B8B82;strokeColor=#0B8B82;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;ellipse;" vertex="1" parent="1"><mxGeometry x="441" y="791" width="18" height="18" as="geometry" /></mxCell><mxCell id="mil1" value="&lt;b&gt;2008 · Распределение CRM-B&lt;/b&gt;&lt;br&gt;С января снижена и перераспределена закачка." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FA;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="390" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="mark2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B8B82;strokeColor=#0B8B82;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;ellipse;" vertex="1" parent="1"><mxGeometry x="741" y="791" width="18" height="18" as="geometry" /></mxCell><mxCell id="mil2" value="&lt;b&gt;2010–2012 · Закачка −4%&lt;/b&gt;&lt;br&gt;Дополнительная коррекция нагнетательных заданий." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF7F6;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="690" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="mark3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B8B82;strokeColor=#0B8B82;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;ellipse;" vertex="1" parent="1"><mxGeometry x="1041" y="791" width="18" height="18" as="geometry" /></mxCell><mxCell id="mil3" value="&lt;b&gt;09.2011 · Скв. №94 SHUT&lt;/b&gt;&lt;br&gt;Один месяц для исключения обратного потока." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FA;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="990" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="mark4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B8B82;strokeColor=#0B8B82;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;ellipse;" vertex="1" parent="1"><mxGeometry x="1341" y="791" width="18" height="18" as="geometry" /></mxCell><mxCell id="mil4" value="&lt;b&gt;02.2013 · Скв. №19&lt;/b&gt;&lt;br&gt;Перевод под закачку сохраняется." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF7F6;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1290" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="mark5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B8B82;strokeColor=#0B8B82;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;ellipse;" vertex="1" parent="1"><mxGeometry x="1641" y="791" width="18" height="18" as="geometry" /></mxCell><mxCell id="mil5" value="&lt;b&gt;09.2025 · Конец расчёта&lt;/b&gt;&lt;br&gt;Результат до 01.09.2025; 2025 год частичный." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FA;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1590" y="835" width="270" height="150" as="geometry" /></mxCell><mxCell id="timeline_note" value="&lt;b&gt;Как получен график:&lt;/b&gt; после проверки физических результатов двух ранее рассчитанных вариантов вручную зафиксирован гибридный режим. TimesFM и Qwen не выбирали этот итоговый график автоматически; Qwen участвует в проверочном полном цикле и не меняет зафиксированные действия." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=15;arcSize=9;spacing=0;" vertex="1" parent="1"><mxGeometry x="65" y="1015" width="1750" height="120" as="geometry" /></mxCell><mxCell id="footer" value="Источник: официальный текст кейса Model Z; финальный запрос TRACK2_FINAL_REQUEST.json. Пороговые значения переведены: 1 атм = 1,01325 бар." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#577184;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1820" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2 · Выбор и полный цикл"><mxGraphModel dx="1900" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1260" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="&lt;b&gt;Как получен и проверен единственный график&lt;/b&gt;&lt;br&gt;Стрелки показывают реальные входы и решения; пунктир — возврат после проваленного пробного расчёта" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1820" height="100" as="geometry" /></mxCell><mxCell id="page" value="2 / 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;fontSize=19;align=right;verticalAlign=middle;spacing=15;arcSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1710" y="35" width="125" height="40" as="geometry" /></mxCell><mxCell id="leftpane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F9FB;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="675" height="885" as="geometry" /></mxCell><mxCell id="lefttitle" value="Подготовка управления" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=22;align=left;verticalAlign=middle;spacing=15;arcSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="625" height="45" as="geometry" /></mxCell><mxCell id="source" value="&lt;b&gt;Архив организаторов Model Z&lt;/b&gt;&lt;br&gt;Геология, история до 31.12.2006, расписание скважин и официальный калькулятор ЧДД." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DBFD1;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="240" width="590" height="85" as="geometry" /></mxCell><mxCell id="options" value="&lt;b&gt;Два ранее рассчитанных режима&lt;/b&gt;&lt;br&gt;F3-01: давление выдержано, но VRR выше 1,15 в 158 месяцах. CRM-B: VRR ближе к диапазону, но давление ниже 108 атм в 33 месяцах." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DBFD1;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="365" width="590" height="100" as="geometry" /></mxCell><mxCell id="decision" value="&lt;b&gt;Явное решение оператора после аудита&lt;/b&gt;&lt;br&gt;F3 в 2007; режим CRM-B с 2008; −4% к заданию закачки в 2010–2012; скв. 94 остановлена в сентябре 2011. Ремонты и перевод скв. 19 сохранены." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF7F4;strokeColor=#8DBFB3;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="505" width="590" height="120" as="geometry" /></mxCell><mxCell id="lock" value="&lt;b&gt;Фиксация входа&lt;/b&gt;&lt;br&gt;23 072 строки: месяц, скважина, роль, OPEN/SHUT, LRAT/WRAT, значение и предел BHP. Проверяются 103 скважины, 224 месяца, SHA-256 расписания." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8EAFC4;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="665" width="590" height="100" as="geometry" /></mxCell><mxCell id="agentnote" value="&lt;b&gt;Роль AIOS / Qwen&lt;/b&gt;&lt;br&gt;Планировщик Qwen через Tatneft LiteLLM получает дайджест всех действий и нормативы; критик получает подтверждённые выходы OPM и ЧДД. Их ответы — рекомендации. В полном цикле они не переписывают месячные задания. Автоматический выбор итогового гибрида не заявлен." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EFF8;strokeColor=#B6A8C9;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="800" width="590" height="195" as="geometry" /></mxCell><mxCell id="la" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="source" target="options"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="options" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="decision" target="lock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rightpane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="750" y="155" width="1110" height="1005" as="geometry" /></mxCell><mxCell id="righttitle" value="Контрольный полный цикл на A100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=22;align=left;verticalAlign=middle;spacing=15;arcSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="775" y="175" width="1060" height="45" as="geometry" /></mxCell><mxCell id="gate1" value="&lt;b&gt;1. Входные ворота&lt;/b&gt;&lt;br&gt;Архив и SHA; полное покрытие фонда; 16 ремонтов; контроль целевых дебитов ≤600; BHP в задании." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3F8;strokeColor=#A9C7D8;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="785" y="255" width="305" height="112" as="geometry" /></mxCell><mxCell id="plan" value="&lt;b&gt;2. Qwen: план&lt;/b&gt;&lt;br&gt;Проверяет хешированный дайджест и решает, допустить ли уже зафиксированное расписание." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EFF8;strokeColor=#B6A8C9;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1140" y="255" width="305" height="112" as="geometry" /></mxCell><mxCell id="opm" value="&lt;b&gt;3. OPM Flow&lt;/b&gt;&lt;br&gt;Единственный вход Model_Z_sch.inc; 224 месяца, образ симулятора с фиксированным digest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E8;strokeColor=#D5AD81;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1495" y="255" width="305" height="112" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="gate1" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="plan" target="opm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="summary" value="&lt;b&gt;4. OPM → SUMMARY&lt;/b&gt;&lt;br&gt;Ряды по 103 скважинам: WLPR, WWIR, WBHP, WVPT, WVIT; поле FPR берётся из SMSPEC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E8;strokeColor=#D5AD81;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1495" y="440" width="305" height="125" as="geometry" /></mxCell><mxCell id="checks" value="&lt;b&gt;5. Численные ворота&lt;/b&gt;&lt;br&gt;600/600 м³/сут; BHP; 16 ремонтов; VRR за 3 месяца; FPR ≥109,431 бар." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#D8BC86;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="305" height="125" as="geometry" /></mxCell><mxCell id="decisiondiamond" value="Условия выполнены?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C7822B;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=15;arcSize=9;rhombus;" vertex="1" parent="1"><mxGeometry x="785" y="452" width="290" height="100" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="opm" target="summary"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="summary" target="checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="checks" target="decisiondiamond"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="repairloop" value="&lt;b&gt;Нет → исправить управление&lt;/b&gt;&lt;br&gt;Пробный сценарий исключается; новый полный расчёт с новым запросом." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D9A6A2;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="795" y="630" width="340" height="105" as="geometry" /></mxCell><mxCell id="export" value="&lt;b&gt;Да → физический CSV&lt;/b&gt;&lt;br&gt;Разницы накопленных объёмов и масса нефти по плотностям PVT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3F8;strokeColor=#A9C7D8;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1190" y="630" width="280" height="105" as="geometry" /></mxCell><mxCell id="chdd" value="&lt;b&gt;6. Официальный ЧДД&lt;/b&gt;&lt;br&gt;Калькулятор и Excel-нормативы на 2007–08.2025." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E8;strokeColor=#D5AD81;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1510" y="630" width="290" height="105" as="geometry" /></mxCell><mxCell id="e6" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B94D4A;strokeWidth=3;fontColor=#B94D4A;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="decisiondiamond" target="repairloop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B94D4A;strokeWidth=3;fontColor=#B94D4A;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="repairloop" target="decision"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="680" /><mxPoint x="740" y="560" /></Array></mxGeometry></mxCell><mxCell id="e8" value="пройдено" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="decisiondiamond" target="export"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="export" target="chdd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="critic" value="&lt;b&gt;7. Qwen: критик&lt;/b&gt;&lt;br&gt;Читает подтверждённые метрики, SHA и ЧДД; не меняет управление." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EFF8;strokeColor=#B6A8C9;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1190" y="825" width="280" height="102" as="geometry" /></mxCell><mxCell id="receipt" value="&lt;b&gt;8. Квитанция&lt;/b&gt;&lt;br&gt;Входной запрос, хеши OPM и экспорта, ЧДД, статус полного цикла." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF7F4;strokeColor=#8DBFB3;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="1510" y="825" width="290" height="102" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="chdd" target="critic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="790" /><mxPoint x="1330" y="790" /></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B8B82;strokeWidth=3;fontColor=#0B8B82;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;flowAnimation=1;flowDuration=1200;" edge="1" parent="1" source="critic" target="receipt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;Граница доказательства:&lt;/b&gt; встроенный валидатор GitLab final проверяет 21 правило из запроса; VRR помечен как диагностический, потому что кейс требует «преимущественно». Давление FPR и долю месяцев VRR проверяет отдельный аудит исходного OPM. Квитанция полного цикла экспериментальная и не является сертификатом организаторов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FA;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="785" y="990" width="1015" height="125" as="geometry" /></mxCell><mxCell id="footer" value="Схема отражает фактический финальный запрос, а не предполагаемый автономный выбор TimesFM или скрытую правку данных во время проверки." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3F7;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#577184;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1820" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="evidence" name="3 · Результат и ограничения"><mxGraphModel dx="1900" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1260" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="&lt;b&gt;Что показывает физический расчёт&lt;/b&gt;&lt;br&gt;Числа из OPM и официального калькулятора; «преимущественно» показано как доля месяцев, без скрытого допуска" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1820" height="100" as="geometry" /></mxCell><mxCell id="page" value="3 / 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;fontSize=19;align=right;verticalAlign=middle;spacing=15;arcSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1710" y="35" width="125" height="40" as="geometry" /></mxCell><mxCell id="metric0" value="&lt;b&gt;ЧДД итогового графика&lt;/b&gt;&lt;br&gt;4,030.28 млн ₽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F3;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="430" height="105" as="geometry" /></mxCell><mxCell id="metric1" value="&lt;b&gt;К прежнему режиму&lt;/b&gt;&lt;br&gt;+158.30 млн ₽ / +4.09%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F3;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="495" y="150" width="430" height="105" as="geometry" /></mxCell><mxCell id="metric2" value="&lt;b&gt;VRR в диапазоне&lt;/b&gt;&lt;br&gt;210 / 224 месяца" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E7;strokeColor=#D7E2EA;strokeWidth=1.5;fontColor=#203447;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=15;arcSize=9;" vertex="1" parent="1"><mxGeometry x="950" y=