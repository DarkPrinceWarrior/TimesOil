<mxfile host="app.diagrams.net" modified="2026-09-27T12:00:00Z" agent="Codex" version="24.7.17" type="device"><diagram id="scorp-track2-one-sheet" name="Единая схема Scorp · Track 2 Model Z"><mxGraphModel dx="2400" dy="5600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="5600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="" style="rounded=1;arcSize=8;strokeColor=#183153;fillColor=#183153;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2400" height="18" as="geometry" /></mxCell><mxCell id="t2" value="&lt;div style=&quot;font-size:42px;color:#183153;font-weight:bold;line-height:1.3&quot;&gt;Scorp · Model Z · один график, один полный прогон&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="46" width="2100" height="75" as="geometry" /></mxCell><mxCell id="t3" value="&lt;div style=&quot;font-size:23px;color:#187E77;font-weight:normal;line-height:1.3&quot;&gt;Горизонт 2007–2025 · 103 скважины · 224 месяца · результат f3-01: +10,743% ЧДД к сопоставимой базе&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="126" width="2140" height="52" as="geometry" /></mxCell><mxCell id="n4" value="&lt;div style=&quot;font-size:19px;font-weight:bold;color:#243746&quot;&gt;Как читать лист&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;color:#243746;margin-top:8px&quot;&gt;Идите сверху вниз: карта → примеры действий → полный цикл → экономика → ограничения → доказательства. Масштабируйте карту и наведите курсор на скважину для I/J и её режима на январь 2007 года.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=17;strokeColor=#B8D1DA;fillColor=#EFF5F7;fontColor=#24374